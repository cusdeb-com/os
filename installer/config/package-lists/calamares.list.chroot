calamares
calamares-settings-debian

# QML modules required by the Calamares slideshow (slideshowAPI 2).
# Without them the exec-phase slideshow fails with
# "module "QtQuick.Window" is not installed" and shows a blank page.
qml6-module-qtquick
qml6-module-qtquick-window

# Password strength dictionary required by Calamares users module
# Without it the installer prints: "the password fails the dictionary check - error loading dictionary"
cracklib-runtime

# squashfs-tools provides unsquashfs, required by Calamares unpackfs module
# to copy the live filesystem onto the target disk.
squashfs-tools

# Partition/filesystem tools required by Calamares partition and bootloader modules
# dosfstools provides mkfs.fat for the EFI System Partition (ESP).
# parted is used for disk partitioning.
dosfstools
parted

# Wayland display and login stack. Openbox manages the rootful XWayland desktop.
weston
wayland-utils
xwayland
xauth
openbox
greetd
gtkgreet
cage
dbus-user-session
libegl1
libgl1-mesa-dri

# GPU firmware for real hardware (QEMU does not need these, but laptops/desktops do)
firmware-amd-graphics
firmware-misc-nonfree

# Terminal
xterm

# Networking
network-manager
wpasupplicant
iw
wireless-tools
firmware-realtek
firmware-iwlwifi
firmware-atheros
firmware-brcm80211
firmware-mediatek

# Kernel and live-boot stack
linux-image-amd64
live-boot
live-boot-doc
live-config
live-config-doc
live-config-systemd
live-tools
live-task-localisation
live-task-recommended
firmware-linux-free
# Needed by live-config to create the live user (--apt-recommends false drops it).
user-setup

# Bootloader (needed by calamares-bootloader-config)
grub-pc
grub-efi-amd64-bin
efibootmgr
os-prober

# Disk tools (needed by calamares partition module)
smartmontools

# Hardware diagnostics (lspci, lsusb)
pciutils
usbutils

# Essentials
sudo
ca-certificates
xdg-utils

# Optional packages pre-installed in live so they are available in target
# regardless of Calamares network state. The optional-packages-apply job
# removes the ones the user deselects.
htop
mc
vim
fastfetch
tree
curl
wget
