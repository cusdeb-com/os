Author: Artem Lavrukhin <lavryha4590@gmail.com>
Description: Preserve the mask-selected alpha in 32-bit pattern ROPs.
 For 32-bpp destinations, expand monochrome mask bits into the reserved
 byte during the Wine MaskBlt R2_MASKPEN stage. Limit the change to
 the 0xAC0744 mask-combine ROP; keep other ROPs and formats unchanged.
Last-Modified: Mon, 28 Sep 2026 18:13:10 +0300

--- a/src/dlls/win32u/dibdrv/objects.c
+++ b/src/dlls/win32u/dibdrv/objects.c
@@ -2007,6 +2007,22 @@
         *needs_reselect = TRUE;
     }
 
+    if (pattern.bit_count == 1 && pdev->dib.bit_count == 32 && brush->maskblt_alpha)
+    {
+        const RGBQUAD *pattern_colors = get_dib_color_table( &pattern );
+
+        /* MaskBlt's R2_MASKPEN stage uses the monochrome pattern to select
+         * between 32-bit results, so also carry its bit in the reserved byte.
+         */
+        color_table[0] = pattern_colors[0];
+        color_table[1] = pattern_colors[1];
+        color_table[0].rgbReserved = 0;
+        color_table[1].rgbReserved = 0xff;
+        pattern.color_table = color_table;
+        pattern.color_table_size = ARRAY_SIZE( color_table );
+        *needs_reselect = TRUE;
+    }
+
     copy_dib_color_info(&brush->dib, &pdev->dib);
 
     brush->dib.height = pattern.height;
@@ -2108,6 +2124,7 @@
                           const LOGBRUSH *logbrush, const struct brush_pattern *pattern, BOOL dither )
 {
     free_pattern_brush( brush );
+    brush->maskblt_alpha = FALSE;
 
     if (pattern)
     {
