+/* Size at the window DPI of the 16 and 24 pixel standard images. They are
+ * enlarged by a whole factor, the DPI scale rounded to the nearest whole
+ * number. */
+static INT
+TOOLBAR_GetStdBitmapSize(const TOOLBAR_INFO *infoPtr, INT size)
+{
+    UINT dpi = GetDpiForWindow(infoPtr->hwndSelf);
+
+    return size * max(1, (dpi + USER_DEFAULT_SCREEN_DPI / 2) / USER_DEFAULT_SCREEN_DPI);
+}
+
+static BOOL
+TOOLBAR_HasStdBitmaps(const TOOLBAR_INFO *infoPtr)
+{
+    INT i;
+
+    for (i = 0; i < infoPtr->nNumBitmapInfos; i++)
+        if (infoPtr->bitmaps[i].hInst == COMCTL32_hModule) return TRUE;
+    return FALSE;
+}
+
+/* Fit a strip of count images into cells of cx x cy pixels. Each image is
+ * enlarged by the largest whole factor that fits, with pixel replication,
+ * and centered in its cell. The source bitmap is deleted, or returned when
+ * the new one cannot be created. */
+static HBITMAP
+TOOLBAR_FitBitmap(HBITMAP hbm, INT count, INT cx, INT cy)
+{
+    BITMAPINFO bmi = {{sizeof(BITMAPINFOHEADER), cx * count, cy, 1, 32, BI_RGB}};
+    HBITMAP hbmNew, hbmOldSrc, hbmOldDst;
+    HDC hdcSrc, hdcDst;
+    INT i, width, factor;
+    HBRUSH hbr;
+    BITMAP bm;
+    RECT rc;
+
+    if (!GetObjectW(hbm, sizeof(bm), &bm)) return hbm;
+    width = bm.bmWidth / count;
+    if (!width || width > cx || bm.bmHeight > cy || (width == cx && bm.bmHeight == cy)) return hbm;
+    factor = min(cx / width, cy / bm.bmHeight);
+
+    if (!(hbmNew = CreateDIBSection(NULL, &bmi, DIB_RGB_COLORS, NULL, NULL, 0))) return hbm;
+    hdcSrc = CreateCompatibleDC(NULL);
+    hdcDst = CreateCompatibleDC(NULL);
+    hbmOldSrc = SelectObject(hdcSrc, hbm);
+    hbmOldDst = SelectObject(hdcDst, hbmNew);
+
+    SetRect(&rc, 0, 0, cx * count, cy);
+    hbr = CreateSolidBrush(comctl32_color.clrBtnFace);
+    FillRect(hdcDst, &rc, hbr);
+    DeleteObject(hbr);
+
+    SetStretchBltMode(hdcDst, COLORONCOLOR);
+    for (i = 0; i < count; i++)
+        StretchBlt(hdcDst, i * cx + (cx - width * factor) / 2, (cy - bm.bmHeight * factor) / 2,
+                   width * factor, bm.bmHeight * factor, hdcSrc, i * width, 0, width, bm.bmHeight, SRCCOPY);
+
+    SelectObject(hdcSrc, hbmOldSrc);
+    SelectObject(hdcDst, hbmOldDst);
+    DeleteDC(hdcSrc);
+    DeleteDC(hdcDst);
+    DeleteObject(hbm);
+    return hbmNew;
+}
+
