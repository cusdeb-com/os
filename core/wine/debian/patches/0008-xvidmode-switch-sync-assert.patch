Author: CusDeb OS Team
Description: Harden XF86VidMode mode switch against invalid modes.
 ReactOS desk.cpl rebuilds the DEVMODE before calling ChangeDisplaySettingsEx,
 losing the private XF86VidModeModeInfo pointer stored after the structure.
 On 64-bit builds the pointer size can also differ from the asserted value.
 Replace the assert with a graceful failure and add an XSync after the
 XF86VidModeSwitchToMode request so asynchronous BadValue errors are caught
 by X11DRV_check_error() instead of killing the process later.
Last-Modified: Tue, 21 Jul 2026 12:55:00 +0300

--- a/wine-src/dlls/winex11.drv/xvidmode.c
+++ b/wine-src/dlls/winex11.drv/xvidmode.c
@@ -229,10 +229,22 @@
         WARN("Cannot change screen bit depth from %dbits to %dbits!\n",
              screen_bpp, (int)mode->dmBitsPerPel);
 
-    assert(mode->dmDriverExtra == sizeof(XF86VidModeModeInfo *));
+    /* The mode may come from user code that didn't preserve the private
+     * XF86VidModeModeInfo pointer (e.g. ReactOS desk.cpl rebuilds the DEVMODE).
+     * On 64-bit builds the pointer size can also differ.  Skip the assert and
+     * let the X server report an invalid mode as a regular failure. */
+    if (mode->dmDriverExtra != sizeof(XF86VidModeModeInfo *))
+    {
+        WARN("Invalid dmDriverExtra %u, expected %zu.\n",
+             mode->dmDriverExtra, sizeof(XF86VidModeModeInfo *));
+        return DISP_CHANGE_FAILED;
+    }
     memcpy(&xf86vm_mode, (BYTE *)mode + sizeof(*mode), sizeof(xf86vm_mode));
     X11DRV_expect_error(gdi_display, XVidModeErrorHandler, NULL);
     ret = pXF86VidModeSwitchToMode(gdi_display, DefaultScreen(gdi_display), xf86vm_mode);
+    /* XF86VidModeSwitchToMode errors are asynchronous on some X servers.
+     * Force a sync so X11DRV_check_error() sees the error before we return. */
+    XSync(gdi_display, False);
     if (X11DRV_check_error() || !ret)
         return DISP_CHANGE_FAILED;
 #if 0 /* it is said that SetViewPort causes problems with some X servers */
