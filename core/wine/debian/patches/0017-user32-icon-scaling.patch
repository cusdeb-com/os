+/* Scale a color icon with filtering. Transparency comes from its alpha channel
+ * or AND mask and ends up in the frame's alpha bitmap and mask. */
+static BOOL create_scaled_icon_frame( HDC hdc, const BITMAPINFO *bmi, const void *color_bits,
+                                      const BYTE *mask_bits, int width, int height,
+                                      struct cursoricon_frame *frame )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[2] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    int src_width = bmi->bmiHeader.biWidth, src_height = abs( bmi->bmiHeader.biHeight );
+    int mask_stride = ((src_width + 31) / 8) & ~3, dst_stride = ((width + 31) / 8) & ~3;
+    BOOL has_alpha = bmi_has_alpha( bmi, color_bits );
+    float *pixels, *rows = NULL, *scaled = NULL;
+    BYTE *mask = NULL;
+    DWORD *bits, *color = NULL;
+    HBITMAP src;
+    BOOL ret = FALSE;
+    int x, y, k;
+
+    memset( info, 0, sizeof(buffer) );
+    info->bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    info->bmiHeader.biWidth = src_width;
+    info->bmiHeader.biHeight = bmi->bmiHeader.biHeight;
+    info->bmiHeader.biPlanes = 1;
+    info->bmiHeader.biBitCount = 32;
+    info->bmiHeader.biCompression = BI_RGB;
+    if (!(src = CreateDIBSection( hdc, info, DIB_RGB_COLORS, (void **)&bits, NULL, 0 ))) return FALSE;
+    SelectObject( hdc, src );
+    StretchDIBits( hdc, 0, 0, src_width, src_height, 0, 0, src_width, src_height,
+                   color_bits, bmi, DIB_RGB_COLORS, SRCCOPY );
+
+    if (!(pixels = malloc( src_width * src_height * 4 * sizeof(float) )) ||
+        !(rows = malloc( width * src_height * 4 * sizeof(float) )) ||
+        !(scaled = malloc( width * height * 4 * sizeof(float) )) ||
+        !(mask = calloc( height, dst_stride )) ||
+        !(color = malloc( width * height * sizeof(*color) )))
+        goto done;
+
+    for (y = 0; y < src_height; y++)
+        for (x = 0; x < src_width; x++)
+        {
+            DWORD pixel = bits[y * src_width + x];
+            float alpha = has_alpha ? pixel >> 24 : 255;
+
+            if (!has_alpha && mask_bits && (mask_bits[y * mask_stride + x / 8] & (0x80 >> (x % 8))))
+                alpha = 0;
+            for (k = 0; k < 3; k++)
+                pixels[(y * src_width + x) * 4 + k] = ((pixel >> (8 * k)) & 0xff) * alpha / 255;
+            pixels[(y * src_width + x) * 4 + 3] = alpha;
+        }
+
+    for (y = 0; y < src_height; y++)
+        resample_line( pixels + y * src_width * 4, src_width, 4, rows + y * width * 4, width, 4 );
+    for (x = 0; x < width; x++)
+        resample_line( rows + x * 4, src_height, width * 4, scaled + x * 4, height, width * 4 );
+
+    /* The color bitmap is not premultiplied, as GetIconInfo callers expect. */
+    for (y = 0; y < height; y++)
+        for (x = 0; x < width; x++)
+        {
+            const float *px = scaled + (y * width + x) * 4;
+            DWORD pixel = (DWORD)(px[3] + 0.5f) << 24;
+
+            if (px[3] >= 0.5f)
+                for (k = 0; k < 3; k++)
+                    pixel |= (DWORD)min( px[k] * 255 / px[3] + 0.5f, 255 ) << (8 * k);
+            color[y * width + x] = pixel;
+            if (px[3] < 128) mask[y * dst_stride + x / 8] |= 0x80 >> (x % 8);
+        }
+
+    info->bmiHeader.biWidth = width;
+    info->bmiHeader.biHeight = bmi->bmiHeader.biHeight < 0 ? -height : height;
+    if (!(frame->color = create_color_bitmap( width, height ))) goto done;
+    SelectObject( hdc, frame->color );
+    StretchDIBits( hdc, 0, 0, width, height, 0, 0, width, height,
+                   color, info, DIB_RGB_COLORS, SRCCOPY );
+    frame->alpha = create_alpha_bitmap( frame->color, info, color );
+
+    if (!(frame->mask = CreateBitmap( width, height, 1, 1, NULL ))) goto done;
+    info->bmiHeader.biBitCount = 1;
+    info->bmiColors[1].rgbBlue = info->bmiColors[1].rgbGreen = info->bmiColors[1].rgbRed = 0xff;
+    SelectObject( hdc, frame->mask );
+    StretchDIBits( hdc, 0, 0, width, height, 0, 0, width, height,
+                   mask, info, DIB_RGB_COLORS, SRCCOPY );
+    ret = TRUE;
+
+done:
+    DeleteObject( src );
+    free( pixels );
+    free( rows );
+    free( scaled );
+    free( mask );
+    free( color );
+    return ret;
+}
