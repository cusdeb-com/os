+/* Resample one row or column of premultiplied BGRA pixels (4 floats each) with a
+ * triangle filter that widens when shrinking, so shrunk icons are averaged and
+ * enlarged ones interpolated. */
+static void resample_line( const float *src, int src_len, int src_step,
+                           float *dst, int dst_len, int dst_step )
+{
+    float scale = (float)src_len / dst_len, radius = max( scale, 1.0f );
+    int i, j, k;
+
+    for (i = 0; i < dst_len; i++)
+    {
+        float center = (i + 0.5f) * scale - 0.5f, sum[4] = {0}, total = 0;
+        int first = max( 0, (int)(center - radius) ), last = min( src_len - 1, (int)(center + radius) + 1 );
+
+        for (j = first; j <= last; j++)
+        {
+            float weight = 1 - (j > center ? j - center : center - j) / radius;
+
+            if (weight <= 0) continue;
+            for (k = 0; k < 4; k++) sum[k] += weight * src[j * src_step + k];
+            total += weight;
+        }
+        for (k = 0; k < 4; k++) dst[i * dst_step + k] = total ? sum[k] / total : 0;
+    }
+}
