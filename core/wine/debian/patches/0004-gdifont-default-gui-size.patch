Author: CusDeb OS Team
Description: Enlarge the stock DEFAULT_GUI_FONT from -11/-12 to -14 px.
 Wine creates the stock DEFAULT_GUI_FONT (MS Shell Dlg) from a hardcoded
 per-charset table in win32u/gdiobj.c. ReactOS shell surfaces that never
 set an explicit font (start menu band, taskbar buttons, tray clock and
 assorted controls) inherit this stock object, so WindowMetrics in the
 registry cannot reach them. Unify all charsets at -14 px (10.5 pt at
 96 DPI) to match the CusDeb global UI font size.
Last-Modified: Fri, 17 Jul 2026 13:38:11 +0300

--- a/src/dlls/win32u/gdiobj.c
+++ b/src/dlls/win32u/gdiobj.c
@@ -156,7 +156,7 @@
            {'C','o','u','r','i','e','r'}
         },
         { /* DefaultGuiFont */
-          -11, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE, ANSI_CHARSET,
+          -14, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE, ANSI_CHARSET,
            0, 0, DEFAULT_QUALITY, VARIABLE_PITCH | FF_SWISS,
            {'M','S',' ','S','h','e','l','l',' ','D','l','g'}
         },
