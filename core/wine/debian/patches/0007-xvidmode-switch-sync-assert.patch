Author: CusDeb OS Team
Description: Add an XSync after XF86VidModeSwitchToMode so asynchronous
 BadValue errors are caught by X11DRV_check_error() instead of killing the
 process later. The old dmDriverExtra assert is no longer applicable because
 Wine 11 re-derives the full mode from the driver mode list.
Last-Modified: Tue, 18 Aug 2026 14:10:00 +0300

--- a/src/dlls/winex11.drv/xvidmode.c
+++ b/src/dlls/winex11.drv/xvidmode.c
@@ -216,6 +216,9 @@
     xf86vm_mode = full_mode->mode_info;
     X11DRV_expect_error(gdi_display, XVidModeErrorHandler, NULL);
     ret = pXF86VidModeSwitchToMode( gdi_display, DefaultScreen(gdi_display), &xf86vm_mode );
+    /* XF86VidModeSwitchToMode errors are asynchronous on some X servers.
+     * Force a sync so X11DRV_check_error() sees the error before we return. */
+    XSync(gdi_display, False);
     if (X11DRV_check_error() || !ret)
         return DISP_CHANGE_FAILED;
 #if 0 /* it is said that SetViewPort causes problems with some X servers */
