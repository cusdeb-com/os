+static NTSTATUS find_actctx_dll( const WCHAR *libname, WCHAR **fullname )
+{
+    ACTCTX_SECTION_KEYED_DATA data = { sizeof(data) };
+    UNICODE_STRING name;
+    NTSTATUS status;
+
+    RtlInitUnicodeString( &name, libname );
+    status = RtlFindActivationContextSectionString( FIND_ACTCTX_SECTION_KEY_RETURN_HACTCTX, NULL,
+                                                    ACTIVATION_CONTEXT_SECTION_DLL_REDIRECTION, &name, &data );
+    if (status != STATUS_SUCCESS) return status;
+
+    status = build_actctx_dll_path( libname, &data, fullname );
     RtlReleaseActivationContext( data.hActCtx );
     return status;
 }
