 /***********************************************************************
+ *		wine_get_sxs_com_server_path (NTDLL.@)
+ *
+ * Resolve a native COM server in the active SxS context and return its absolute
+ * DLL path. The caller frees the process-heap path with HeapFree.
+ * ERROR_SXS_KEY_NOT_FOUND means the class was not declared in SxS and the
+ * caller may consult the registry. Other errors must not trigger that fallback.
+ */
+DWORD WINAPI wine_get_sxs_com_server_path( const GUID *clsid, WCHAR **path )
+{
+    ACTCTX_SECTION_KEYED_DATA com_data = { sizeof(com_data) }, dll_data = { sizeof(dll_data) };
+    ACTIVATION_CONTEXT *actctx;
+    const struct comclassredirect_data *comclass;
+    const WCHAR *module;
+    UNICODE_STRING name;
+    NTSTATUS status = STATUS_SXS_KEY_NOT_FOUND;
+    DWORD error;
+
+    if (!path) return ERROR_INVALID_PARAMETER;
+    *path = NULL;
+    if (!clsid) return ERROR_INVALID_PARAMETER;
+
+    /* Prefer the thread's active context, then check the process default. */
+    actctx = check_actctx( get_current_actctx_no_addref() );
+    if (actctx)
+        status = find_guid( actctx, ACTIVATION_CONTEXT_SECTION_COM_SERVER_REDIRECTION, clsid,
+                            FIND_ACTCTX_SECTION_KEY_RETURN_HACTCTX, &com_data );
+    if (status == STATUS_SXS_KEY_NOT_FOUND && actctx != process_actctx)
+        status = find_guid( process_actctx, ACTIVATION_CONTEXT_SECTION_COM_SERVER_REDIRECTION, clsid,
+                            FIND_ACTCTX_SECTION_KEY_RETURN_HACTCTX, &com_data );
+    if (status != STATUS_SUCCESS) return RtlNtStatusToDosError( status );
+
+    comclass = com_data.lpData;
+    /* This resolver does not support managed COM servers. */
+    if (comclass->clrdata_len)
+    {
+        error = ERROR_NOT_SUPPORTED;
+        goto done;
+    }
+    module = (const WCHAR *)((const BYTE *)com_data.lpSectionBase + comclass->name_offset);
+    RtlInitUnicodeString( &name, module );
+
+    /* Only use the DLL redirection owned by the assembly declaring the class. */
+    status = find_dll_redirection( com_data.hActCtx, &name, &dll_data );
+    if (status == STATUS_SUCCESS)
+    {
+        if (dll_data.ulAssemblyRosterIndex != com_data.ulAssemblyRosterIndex)
+            status = STATUS_SXS_INVALID_ACTCTXDATA_FORMAT;
+        else
+        {
+            dll_data.hActCtx = com_data.hActCtx;
+            status = build_actctx_dll_path( module, &dll_data, path );
+        }
+    }
+    if (status == STATUS_SUCCESS)
+    {
+        switch (RtlDetermineDosPathNameType_U( *path ))
+        {
+        case RtlPathTypeDriveAbsolute:
+        case RtlPathTypeUncAbsolute:
+        case RtlPathTypeLocalDevice:
+            break;
+        default:
+            RtlFreeHeap( GetProcessHeap(), 0, *path );
+            *path = NULL;
+            status = STATUS_OBJECT_PATH_SYNTAX_BAD;
+            break;
+        }
+    }
+    /* A missing DLL must not trigger registry fallback for a class found in SxS. */
+    error = status == STATUS_SXS_KEY_NOT_FOUND ? ERROR_MOD_NOT_FOUND : RtlNtStatusToDosError( status );
+
+done:
+    RtlReleaseActivationContext( com_data.hActCtx );
+    return error;
+}
+
