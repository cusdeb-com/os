+/* Scale a size given in pixels at 96 DPI to the DPI of the window. */
+static int get_scaled_metric(const TOOLBAR_INFO *infoPtr, int value)
+{
+    return MulDiv(value, GetDpiForWindow(infoPtr->hwndSelf), USER_DEFAULT_SCREEN_DPI);
+}
