#!/usr/bin/env python3
"""Run CDEX and Openbox inside fullscreen rootful XWayland on Weston."""

import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import secrets
import selectors
import signal
import socket
import subprocess
import sys
import tempfile
import time


def stop(process):
    if process is None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        process.wait()
        return
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()


def check_ready(processes, deadline, description):
    for name, process in processes:
        if process.poll() is not None:
            raise RuntimeError(f"{name} exited before {description}: {process.returncode}")
    if time.monotonic() >= deadline:
        raise TimeoutError(f"Timed out waiting for {description}")


def wait_wayland(path, compositor, deadline):
    while True:
        check_ready([("Weston", compositor)], deadline, "Wayland socket")
        with socket.socket(socket.AF_UNIX) as connection:
            connection.settimeout(0.2)
            try:
                connection.connect(str(path))
                return
            except (FileNotFoundError, ConnectionRefusedError, socket.timeout):
                pass
        time.sleep(0.05)


def read_display(fd, processes, deadline):
    data = bytearray()
    with selectors.DefaultSelector() as selector:
        selector.register(fd, selectors.EVENT_READ)
        while b"\n" not in data:
            check_ready(processes, deadline, "XWayland display number")
            if not selector.select(timeout=0.1):
                continue
            chunk = os.read(fd, 16)
            if not chunk:
                raise RuntimeError("XWayland closed its readiness pipe")
            data.extend(chunk)
            if len(data) > 16:
                raise RuntimeError("Invalid XWayland display number")
    number = bytes(data).strip()
    if not number or not number.isdigit():
        raise RuntimeError("Invalid XWayland display number")
    return ":" + number.decode("ascii")


def authorize(authority, display, cookie):
    subprocess.run(
        ["xauth", "-f", str(authority), "add", display, "MIT-MAGIC-COOKIE-1", cookie],
        check=True, timeout=10,
    )


def output_geometry(environment, deadline):
    # XWayland 24.1 otherwise starts rootful fullscreen at 640x480 and
    # scales it to the output. Use Weston's logical size before starting WM.
    result = subprocess.run(
        ["wayland-info"], env={**environment, "LC_ALL": "C"},
        capture_output=True, text=True, check=True,
        timeout=max(0.1, deadline - time.monotonic()),
    )
    outputs = re.findall(r"logical_width:\s*(\d+), logical_height:\s*(\d+)", result.stdout)
    if len(outputs) != 1:
        raise RuntimeError("Automatic XWayland geometry requires one Wayland output; use --geometry WIDTHxHEIGHT")
    return "x".join(outputs[0])


def run_session(args, runtime):
    command = args.command
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        command = ["cdex-win32-session"]

    environment = os.environ.copy()
    environment.update({
        "XDG_SESSION_TYPE": "wayland",
        "XDG_CURRENT_DESKTOP": "CusDebWin32:Openbox",
        "DESKTOP_SESSION": "cusdeb-wayland",
    })
    if "DBUS_SESSION_BUS_ADDRESS" not in environment and (runtime / "bus").exists():
        environment["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={runtime / 'bus'}"
    environment.pop("DISPLAY", None)
    environment.pop("XAUTHORITY", None)
    environment.pop("WAYLAND_SOCKET", None)
    if args.backend != "wayland":
        environment.pop("WAYLAND_DISPLAY", None)

    published = runtime / "cdex-wayland-environment.json"
    published.unlink(missing_ok=True)
    compositor = xwayland = shell = None
    display_read = display_write = None
    socket_name = f"cdex-wayland-{os.getpid()}"
    with tempfile.TemporaryDirectory(prefix="cdex-xwayland-", dir=runtime) as directory:
        authority = Path(directory) / "Xauthority"
        authority.touch(mode=0o600)
        cookie = secrets.token_hex(16)
        # XWayland loads the cookie from this file; after -displayfd chooses a
        # display, add the matching client record with the same cookie.
        authorize(authority, ":0", cookie)
        try:
            compositor_command = [
                args.compositor, f"--backend={args.backend}-backend.so",
                "--shell=kiosk-shell.so", "--no-config", "--idle-time=0",
                f"--socket={socket_name}",
            ]
            if args.renderer:
                compositor_command.append(f"--renderer={args.renderer}")
            compositor = subprocess.Popen(
                compositor_command, env=environment, start_new_session=True,
            )
            deadline = time.monotonic() + args.ready_timeout
            wait_wayland(runtime / socket_name, compositor, deadline)
            environment["WAYLAND_DISPLAY"] = socket_name
            geometry = args.geometry or output_geometry(environment, deadline)
            display_read, display_write = os.pipe()
            xwayland = subprocess.Popen([
                args.xwayland, "-fullscreen", "-host-grab", "-nolisten", "tcp",
                "-geometry", geometry,
                "-noreset", "-auth", str(authority), "-displayfd", str(display_write),
            ], env=environment, pass_fds=(display_write,), start_new_session=True)
            os.close(display_write)
            display_write = None
            display = read_display(
                display_read, [("Weston", compositor), ("XWayland", xwayland)], deadline,
            )
            os.close(display_read)
            display_read = None
            authorize(authority, display, cookie)
            # Keep Linux applications inside the existing Openbox/taskbar
            # desktop even though the outer login session uses Wayland.
            environment.update({
                "DISPLAY": display, "XAUTHORITY": str(authority),
                "CDEX_ROOTFUL_XWAYLAND": "1",
                "GDK_BACKEND": "x11", "QT_QPA_PLATFORM": "xcb",
                "SDL_VIDEODRIVER": "x11", "MOZ_ENABLE_WAYLAND": "0",
            })
            fd = os.open(published, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            keys = (
                "DISPLAY", "WAYLAND_DISPLAY", "XAUTHORITY", "XDG_SESSION_TYPE",
                "XDG_CURRENT_DESKTOP", "DESKTOP_SESSION", "XDG_RUNTIME_DIR",
                "DBUS_SESSION_BUS_ADDRESS", "CDEX_ROOTFUL_XWAYLAND", "GDK_BACKEND",
                "QT_QPA_PLATFORM", "SDL_VIDEODRIVER", "MOZ_ENABLE_WAYLAND",
            )
            with os.fdopen(fd, "w") as stream:
                json.dump({key: environment[key] for key in keys if key in environment}, stream)
                stream.write("\n")
            print(f"CDEX: rootful XWayland ready on {display}; starting Openbox session", flush=True)
            shell = subprocess.Popen(command, env=environment, start_new_session=True)
            while True:
                for process in (compositor, xwayland):
                    if process.poll() is not None:
                        return process.returncode or 1
                if shell.poll() is not None:
                    return shell.returncode
                time.sleep(0.1)
        finally:
            published.unlink(missing_ok=True)
            stop(shell)
            stop(xwayland)
            stop(compositor)
            for fd in (display_read, display_write):
                if fd is not None:
                    os.close(fd)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--compositor", default="weston")
    parser.add_argument("--xwayland", default="Xwayland")
    parser.add_argument("--backend", choices=("drm", "wayland", "headless"), default="drm")
    parser.add_argument("--renderer", choices=("gl", "pixman"))
    parser.add_argument("--geometry", help="XWayland root size WIDTHxHEIGHT (default: single output's logical size)")
    parser.add_argument("--ready-timeout", type=float, default=60)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.ready_timeout <= 0:
        parser.error("--ready-timeout must be positive")
    if args.geometry and (not re.fullmatch(r"[1-9][0-9]*x[1-9][0-9]*", args.geometry)
                          or any(int(value) > 32767 for value in args.geometry.split("x"))):
        parser.error("--geometry must be WIDTHxHEIGHT, each dimension between 1 and 32767")
    runtime = Path(os.environ["XDG_RUNTIME_DIR"])
    # The diagnostic environment file is per user, so allow one session per
    # runtime directory. Never remove another running session's environment.
    with (runtime / "cdex-wayland-session.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError("A CDEX Wayland session is already running") from None
        return run_session(args, runtime)


if __name__ == "__main__":
    def interrupted(_number, _frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, interrupted)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except (KeyError, OSError, RuntimeError, TimeoutError, ValueError, subprocess.SubprocessError) as error:
        print(f"cdex-wayland-session: {error}", file=sys.stderr)
        sys.exit(1)
