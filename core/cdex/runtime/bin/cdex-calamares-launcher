#!/bin/bash
# Launch Calamares through the live session's authenticated XWayland.
# pkexec strips the environment, so pass DISPLAY and XAUTHORITY explicitly.
set -euo pipefail

: "${DISPLAY:?Run Calamares from the CDEX Wayland session}"
: "${XAUTHORITY:?The session XWayland authority is required}"

exec pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" QT_QPA_PLATFORM=xcb calamares "$@"
