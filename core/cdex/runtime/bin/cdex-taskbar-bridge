#!/usr/bin/python3
import argparse
import hashlib
import json
import os
import re
import shutil
import struct
import subprocess
import tempfile
import time


WINDOW_ID_RE = re.compile(r"0x[0-9a-fA-F]+")

# Maximum icon dimension the bridge will parse/export.
_MAX_ICON_SIZE = 256

# In the ICO directory a zero width/height byte means exactly 256 pixels
# (the field is a single byte); kept separate from _MAX_ICON_SIZE because
# the two limits are unrelated semantically.
_ICO_DIMENSION_BYTE_LIMIT = 256

# Pixels with alpha below this threshold are marked transparent in the
# AND bitmask of the BMP-based .ico.
_ALPHA_MASK_THRESHOLD = 128

# Little-endian 32-bit unsigned integer struct format.
_UINT32_LE = "<I"

# BITMAPINFOHEADER: biSize, biWidth, biHeight, biPlanes, biBitCount,
# biCompression, biSizeImage, biXPelsPerMeter, biYPelsPerMeter, biClrUsed, biClrImportant
_BITMAP_INFO_HEADER_FMT = "<IiiHHIIiiII"

# ICONDIR entry: bWidth, bHeight, bColorCount, bReserved, wPlanes, wBitCount,
# dwBytesInRes, dwImageOffset
_ICON_DIR_ENTRY_FMT = "<BBBBHHII"

# ICONDIR: idReserved, idType, idCount
_ICON_DIR_FMT = "<HHH"


_NORMALIZED_WINDOWS = set()
_icon_dir = None

# _NET_WM_ICON_GEOMETRY tells openbox where a window's taskbar button is, so
# its iconify animation slides to the button instead of a default off-screen
# point. The ReactOS taskbar is a Wine window and cannot set it, so the
# bridge sets it instead: exact button rects come from the explorer via a
# sidecar JSON (see --buttons); as a fallback they are approximated from the
# window order it publishes.
_ICON_GEOMETRY = {}
_TASKBAR_BUTTONS_X = 60
_TASKBAR_BUTTON_WIDTH = 160
_TASKBAR_HEIGHT = 24

# window_id -> (sha1 of the raw _NET_WM_ICON payload, exported .ico path)
_ICON_CACHE = {}

# Sidecar JSON written by the ReactOS explorer (patch 0002) with exact
# taskbar button rects; None when --buttons is not passed.
_buttons_path = None

# The last poll's active task window. Clicking a taskbar button moves X
# activation to the taskbar dock *before* the control command reaches the
# bridge, so _NET_ACTIVE_WINDOW cannot be trusted at the moment a command
# is processed. The poll loop keeps this updated instead, and deliberately
# keeps the current value while activation sits on a dock (the taskbar
# itself), so a taskbar click never clobbers it.
_LAST_ACTIVE_TASK_WINDOW = None


def run_text(command):
    try:
        return subprocess.check_output(command, stderr=subprocess.DEVNULL, text=True)
    except (FileNotFoundError, subprocess.CalledProcessError):
        return ""


def parse_string(line):
    if "=" not in line:
        return ""
    value = line.split("=", 1)[1].strip()
    if value == "not found.":
        return ""
    try:
        return json.loads(value)
    except json.JSONDecodeError:
        return value.strip('"')


def parse_atoms(line):
    if "=" not in line:
        return []
    value = line.split("=", 1)[1].strip()
    if value == "not found.":
        return []
    return [part.strip() for part in value.split(",") if part.strip()]


def get_window_ids():
    output = run_text(["xprop", "-root", "_NET_CLIENT_LIST"])
    return WINDOW_ID_RE.findall(output)


def read_window(window_id):
    output = run_text([
        "xprop",
        "-id",
        window_id,
        "WM_CLASS",
        "WM_NAME",
        "_NET_WM_NAME",
        "_NET_WM_PID",
        "_NET_WM_WINDOW_TYPE",
        "_NET_WM_STATE",
    ])
    window = {
        "window_id": window_id,
        "title": "",
        "class": "",
        "instance": "",
        "pid": None,
        "types": [],
        "state": [],
    }
    for line in output.splitlines():
        if line.startswith("WM_CLASS"):
            strings = re.findall(r'"([^"]*)"', line)
            if strings:
                window["instance"] = strings[0]
            if len(strings) > 1:
                window["class"] = strings[1]
        elif line.startswith("_NET_WM_NAME"):
            # xprop prints WM_NAME before _NET_WM_NAME; don't let a missing
            # _NET_WM_NAME ("not found.") clobber the WM_NAME fallback.
            title = parse_string(line)
            if title:
                window["title"] = title
        elif line.startswith("WM_NAME") and not window["title"]:
            window["title"] = parse_string(line)
        elif line.startswith("_NET_WM_PID"):
            match = re.search(r"=\s*(\d+)", line)
            if match:
                window["pid"] = int(match.group(1))
        elif line.startswith("_NET_WM_WINDOW_TYPE"):
            window["types"] = parse_atoms(line)
        elif line.startswith("_NET_WM_STATE"):
            window["state"] = parse_atoms(line)
    return window


def is_task_window(window):
    if not window["title"].strip():
        return False
    state = set(window["state"])
    types = set(window["types"])
    if "_NET_WM_STATE_SKIP_TASKBAR" in state:
        return False
    if "_NET_WM_WINDOW_TYPE_DESKTOP" in types or "_NET_WM_WINDOW_TYPE_DOCK" in types:
        return False
    if window["class"].lower() == "reactos-explorer.exe" and window["title"] == "Program Manager":
        return False
    return True


def set_icon_geometry(window_id, index, button_rect=None, root_size=None):
    """Point openbox's iconify animation at the window's taskbar button."""
    if button_rect:
        rect = f"{button_rect[0]}, {button_rect[1]}, {button_rect[2]}, {button_rect[3]}"
    else:
        root_width, root_height = root_size or get_root_size()
        x = min(_TASKBAR_BUTTONS_X + index * _TASKBAR_BUTTON_WIDTH,
                max(root_width - _TASKBAR_BUTTON_WIDTH, 0))
        rect = f"{x}, {max(root_height - _TASKBAR_HEIGHT, 0)}, {_TASKBAR_BUTTON_WIDTH}, {_TASKBAR_HEIGHT}"
    if _ICON_GEOMETRY.get(window_id) == rect:
        return
    subprocess.run(
        ["xprop", "-id", window_id, "-f", "_NET_WM_ICON_GEOMETRY", "32c", "-set", "_NET_WM_ICON_GEOMETRY", rect],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    _ICON_GEOMETRY[window_id] = rect


def sync_windows():
    """Read all taskbar-eligible windows and sync their side data.

    Besides reading the window list this exports each window's icon to a
    .ico file, sets _NET_WM_ICON_GEOMETRY for the WM's iconify animation
    and prunes icon files that no window references anymore.
    """
    windows = [window for window in (read_window(window_id) for window_id in get_window_ids()) if is_task_window(window)]
    current_ids = {window["window_id"] for window in windows}
    for cache in (_ICON_GEOMETRY, _ICON_CACHE):
        for window_id in list(cache):
            if window_id not in current_ids:
                del cache[window_id]
    button_rects = read_button_rects()
    root_size = get_root_size()
    for index, window in enumerate(windows):
        window["icon"] = get_window_icon_path(window["window_id"])
        set_icon_geometry(window["window_id"], index, button_rects.get(window["window_id"]), root_size)
    prune_icon_dir({window["icon"] for window in windows if window["icon"]})
    return windows


def parse_window_icon(payload):
    """Parse a _NET_WM_ICON payload into a list of (width, height, [ARGB pixels])."""
    try:
        values = [int(part) for part in payload.split(",")]
    except ValueError:
        return []

    icons = []
    offset = 0
    while offset + 2 <= len(values):
        width, height = values[offset], values[offset + 1]
        offset += 2
        size = width * height
        if width <= 0 or height <= 0 or offset + size > len(values):
            break
        # Always advance past the pixel data; oversized entries are skipped,
        # not misparsed as subsequent headers.
        offset += size
        if width > _MAX_ICON_SIZE or height > _MAX_ICON_SIZE:
            continue
        icons.append((width, height, values[offset - size:offset]))
    return icons


def build_ico(icons):
    """Pack (width, height, [ARGB pixels]) entries into a classic BMP-based .ico."""
    images = []
    for width, height, pixels in icons:
        xor = bytearray()
        for src_row in range(height - 1, -1, -1):
            for px in pixels[src_row * width:(src_row + 1) * width]:
                # keep straight (non-premultiplied) alpha: shell32's icon
                # cache already premultiplies while loading 32bpp icons;
                # little-endian ARGB packs to exactly BGRA bytes
                xor += struct.pack(_UINT32_LE, px)
        stride = ((width + 31) // 32) * 4
        mask = bytearray(stride * height)
        for row in range(height):
            for x, px in enumerate(pixels[row * width:(row + 1) * width]):
                if ((px >> 24) & 0xFF) < _ALPHA_MASK_THRESHOLD:
                    mask[(height - 1 - row) * stride + x // 8] |= 0x80 >> (x % 8)
        header = struct.pack(_BITMAP_INFO_HEADER_FMT, 40, width, height * 2, 1, 32, 0, len(xor) + len(mask), 0, 0, 0, 0)
        images.append(header + bytes(xor) + bytes(mask))

    offset = 6 + 16 * len(images)
    entries = []
    for (width, height, _), image in zip(icons, images):
        entries.append(struct.pack(
            _ICON_DIR_ENTRY_FMT,
            width if width < _ICO_DIMENSION_BYTE_LIMIT else 0,
            height if height < _ICO_DIMENSION_BYTE_LIMIT else 0,
            0, 0, 1, 32, len(image), offset)
        )
        offset += len(image)
    return struct.pack(_ICON_DIR_FMT, 0, 1, len(images)) + b"".join(entries) + b"".join(images)


def get_window_icon_path(window_id):
    """Export the window icon to a .ico file shared with the ReactOS side.

    Cached by the hash of the raw _NET_WM_ICON payload: re-parsing and
    re-packing thousands of pixels on every poll just to recompute the same
    content hash costs noticeable CPU per window per cycle.
    """
    if _icon_dir is None:
        return ""

    output = run_text(["xprop", "-id", window_id, "32c", "_NET_WM_ICON"])
    payload = output.split("=", 1)[1] if "=" in output else ""
    payload_hash = hashlib.sha1(payload.encode()).hexdigest() if payload else ""
    cached = _ICON_CACHE.get(window_id)
    if cached and cached[0] == payload_hash:
        return cached[1]

    path = ""
    icons = parse_window_icon(payload) if payload else []
    if icons:
        data = build_ico(icons)
        path = os.path.join(_icon_dir, f"{hashlib.sha1(data).hexdigest()[:16]}.ico")
        if not os.path.exists(path):
            # A local failure (e.g. unwritable icon dir) must not kill the
            # main loop: the icon is simply not exported this cycle.
            try:
                fd, temp_path = tempfile.mkstemp(prefix=".icon-", dir=_icon_dir)
            except OSError:
                path = ""
            else:
                try:
                    with os.fdopen(fd, "wb") as handle:
                        handle.write(data)
                    os.replace(temp_path, path)
                finally:
                    if os.path.exists(temp_path):
                        os.unlink(temp_path)
    _ICON_CACHE[window_id] = (payload_hash, path)
    return path


def prune_icon_dir(used_paths):
    """Drop exported .ico files no window references anymore."""
    if _icon_dir is None or not os.path.isdir(_icon_dir):
        return
    for name in os.listdir(_icon_dir):
        if name.endswith(".ico") and os.path.join(_icon_dir, name) not in used_paths:
            try:
                os.unlink(os.path.join(_icon_dir, name))
            except OSError:
                pass


def read_button_rects():
    """Read exact taskbar button rects exported by the explorer, if any."""
    if _buttons_path is None:
        return {}
    try:
        with open(_buttons_path, "r", encoding="utf-8") as handle:
            payload = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return {}
    if not isinstance(payload, dict):
        return {}
    rects = {}
    for entry in payload.get("buttons", []):
        window_id = str(entry.get("window_id", ""))
        rect = entry.get("rect")
        if (WINDOW_ID_RE.fullmatch(window_id) and isinstance(rect, list)
                and len(rect) == 4 and all(isinstance(v, int) for v in rect)):
            rects[window_id] = rect
    return rects


def get_root_size():
    """Return the root window size as (width, height).

    Queried on every scan (not cached) so resolution changes are picked up.
    Falls back to 1920x1080 when xwininfo fails: a wrong guess only shifts
    the iconify animation target, so a common large desktop resolution is a
    safe default.
    """
    output = run_text(["xwininfo", "-root"])
    match_w = re.search(r"Width:\s+(\d+)", output)
    match_h = re.search(r"Height:\s+(\d+)", output)
    if match_w and match_h:
        return int(match_w.group(1)), int(match_h.group(1))
    return 1920, 1080


def get_window_geometry(window_id):
    output = run_text(["xwininfo", "-id", window_id])
    geo = {}
    for line in output.splitlines():
        if "Absolute upper-left X:" in line:
            geo["x"] = int(line.split(":", 1)[1].strip())
        elif "Absolute upper-left Y:" in line:
            geo["y"] = int(line.split(":", 1)[1].strip())
        elif "Width:" in line and "Relative" not in line:
            geo["width"] = int(line.split(":", 1)[1].strip())
        elif "Height:" in line and "Relative" not in line:
            geo["height"] = int(line.split(":", 1)[1].strip())
    return geo


def set_xprop(window_id, prop, fmt, value_str):
    try:
        subprocess.run(
            ["xprop", "-id", window_id, "-f", prop, fmt, "-set", prop, value_str],
            stderr=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            check=True,
        )
        return True
    except (FileNotFoundError, subprocess.CalledProcessError):
        return False


def normalize_desktop_window(window):
    window_id = window["window_id"]
    types = set(window.get("types", []))
    state = set(window.get("state", []))

    desired_type = "_NET_WM_WINDOW_TYPE_DESKTOP"
    desired_state = {"_NET_WM_STATE_BELOW", "_NET_WM_STATE_SKIP_TASKBAR", "_NET_WM_STATE_SKIP_PAGER"}

    changed = False

    if desired_type not in types:
        if set_xprop(window_id, "_NET_WM_WINDOW_TYPE", "32a", desired_type):
            print(f"taskbar bridge: set {window_id} desktop type", flush=True)
            changed = True

    if not desired_state.issubset(state):
        state_str = ",".join(desired_state)
        if set_xprop(window_id, "_NET_WM_STATE", "32a", state_str):
            print(f"taskbar bridge: set {window_id} desktop state", flush=True)
            changed = True

    return changed


def normalize_taskbar_window(window, root_width, root_height):
    window_id = window["window_id"]
    types = set(window.get("types", []))
    state = set(window.get("state", []))

    desired_type = "_NET_WM_WINDOW_TYPE_DOCK"
    desired_state = {"_NET_WM_STATE_SKIP_TASKBAR", "_NET_WM_STATE_SKIP_PAGER", "_NET_WM_STATE_STICKY"}

    changed = False

    if desired_type not in types:
        if set_xprop(window_id, "_NET_WM_WINDOW_TYPE", "32a", desired_type):
            print(f"taskbar bridge: set {window_id} dock type", flush=True)
            changed = True

    if not desired_state.issubset(state):
        state_str = ",".join(desired_state)
        if set_xprop(window_id, "_NET_WM_STATE", "32a", state_str):
            print(f"taskbar bridge: set {window_id} dock state", flush=True)
            changed = True

    # Check if strut already set
    has_strut = "=" in run_text(["xprop", "-id", window_id, "_NET_WM_STRUT_PARTIAL"])
    if not has_strut:
        geo = get_window_geometry(window_id)
        if geo:
            bottom = root_height - geo.get("y", 0)
            # Sanity: taskbar is at bottom, small height
            if bottom > 0 and bottom < 200:
                strut_val = f"0,0,0,{bottom},0,0,0,0,0,0,0,{root_width - 1}"
                if set_xprop(window_id, "_NET_WM_STRUT", "32c", f"0,0,0,{bottom}"):
                    print(f"taskbar bridge: set {window_id} strut bottom={bottom}", flush=True)
                    changed = True
                if set_xprop(window_id, "_NET_WM_STRUT_PARTIAL", "32c", strut_val):
                    print(f"taskbar bridge: set {window_id} strut partial", flush=True)
                    changed = True

    return changed


def normalize_window(window, root_width, root_height):
    if window["class"].lower() != "reactos-explorer.exe":
        return False

    if window["title"] == "Program Manager":
        return normalize_desktop_window(window)

    if window["title"] == "":
        # Candidate for taskbar; verify geometry if not already dock
        types = set(window.get("types", []))
        if "_NET_WM_WINDOW_TYPE_DOCK" in types:
            return False
        geo = get_window_geometry(window["window_id"])
        if geo:
            # Taskbar: wide, short, near bottom of screen
            if geo.get("width", 0) > root_width * 0.7 and geo.get("height", 0) < 100 and geo.get("y", 0) > root_height * 0.8:
                return normalize_taskbar_window(window, root_width, root_height)
    return False


def scan_and_normalize_windows():
    global _NORMALIZED_WINDOWS
    root_width, root_height = get_root_size()
    current_ids = set(get_window_ids())
    # Clean up cached ids for windows that no longer exist
    _NORMALIZED_WINDOWS &= current_ids
    for window_id in current_ids:
        if window_id in _NORMALIZED_WINDOWS:
            continue
        window = read_window(window_id)
        if normalize_window(window, root_width, root_height):
            _NORMALIZED_WINDOWS.add(window_id)


def write_atomic(path, payload):
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    fd, temp_path = tempfile.mkstemp(prefix=".reactos-taskbar-", dir=directory, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False, indent=2, sort_keys=True)
            handle.write("\n")
        os.replace(temp_path, path)
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)


def launch_first_available(commands):
    for command in commands:
        if shutil.which(command[0]):
            print("taskbar bridge:", " ".join(command), flush=True)
            subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
    print("taskbar bridge: no focus/control tool found for", commands, flush=True)
    return False



def log_startup():
    print(f"taskbar bridge: DISPLAY={os.environ.get('DISPLAY', '')}", flush=True)
    print(f"taskbar bridge: PATH={os.environ.get('PATH', '')}", flush=True)
    for tool in ("xprop", "wmctrl", "xdotool"):
        print(f"taskbar bridge: {tool}={shutil.which(tool) or 'missing'}", flush=True)


def get_active_window_id():
    output = run_text(["xprop", "-root", "_NET_ACTIVE_WINDOW"])
    match = WINDOW_ID_RE.search(output)
    return match.group(0).lower() if match else ""


def is_dock_window(window_id):
    output = run_text(["xprop", "-id", window_id, "_NET_WM_WINDOW_TYPE"])
    return "_NET_WM_WINDOW_TYPE_DOCK" in output


def track_active_task_window(windows):
    global _LAST_ACTIVE_TASK_WINDOW
    active = get_active_window_id()
    task_ids = {window["window_id"].lower() for window in windows}
    if active in task_ids:
        _LAST_ACTIVE_TASK_WINDOW = active
    elif not active or active == "0x0" or not is_dock_window(active):
        _LAST_ACTIVE_TASK_WINDOW = None


def activate_window(window_id):
    """Unminimize + activate, then verify the activation stuck.

    When the request comes from a taskbar click, the taskbar (or Wine,
    on unminimize) can steal the focus back right after the first
    attempt, leaving the restored window unfocused. Retry a couple of
    times. Returns True when the window ended up active.
    """
    for _attempt in range(3):
        if not launch_first_available([["wmctrl", "-ia", window_id],
                                       ["xdotool", "windowmap", window_id, "windowactivate", window_id]]):
            return False
        time.sleep(0.2)
        if window_id.lower() == get_active_window_id():
            return True
        print(f"taskbar bridge: focus {window_id} did not stick, retrying", flush=True)
    return False


def handle_control(path):
    global _LAST_ACTIVE_TASK_WINDOW
    if not os.path.exists(path):
        return
    try:
        stat_result = os.stat(path)
        if stat_result.st_uid != os.getuid() or not os.path.isfile(path):
            return
        with open(path, "r", encoding="utf-8") as handle:
            message = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass

    window_id = str(message.get("window_id", ""))
    action = str(message.get("action", ""))
    if not WINDOW_ID_RE.fullmatch(window_id):
        return
    if action == "focus":
        # Clicking the taskbar button of the already-active window must
        # minimize it (standard taskbar toggle behaviour); only activate
        # the window when it is not the active one.
        if window_id.lower() == _LAST_ACTIVE_TASK_WINDOW:
            print(f"taskbar bridge: minimize active {window_id}", flush=True)
            launch_first_available([["xdotool", "windowminimize", window_id]])
            _LAST_ACTIVE_TASK_WINDOW = None
        else:
            print(f"taskbar bridge: focus {window_id}", flush=True)
            if activate_window(window_id):
                _LAST_ACTIVE_TASK_WINDOW = window_id.lower()
    elif action == "minimize":
        print(f"taskbar bridge: minimize {window_id}", flush=True)
        launch_first_available([["xdotool", "windowminimize", window_id]])
    elif action == "close":
        print(f"taskbar bridge: close {window_id}", flush=True)
        launch_first_available([["wmctrl", "-ic", window_id], ["xdotool", "windowclose", window_id]])


LINUX_LAUNCHERS = {
    "terminal": ["xterm"],
    "calamares": ["/usr/bin/cdex-calamares-launcher"],
    "display-settings": ["/usr/bin/cdex-display-properties"],
    "poweroff": ["/usr/bin/cdex-shutdown-helper", "poweroff"],
    "reboot": ["/usr/bin/cdex-shutdown-helper", "reboot"],
}


def launch_linux_app(name):
    command = LINUX_LAUNCHERS.get(name)
    if not command:
        print(f"taskbar bridge: unknown launcher {name!r}", flush=True)
        return
    home = os.path.expanduser("~")
    env = os.environ.copy()
    env.update({
        "HOME": home,
        "SHELL": os.environ.get("SHELL", "/bin/bash") or "/bin/bash",
    })
    print(f"taskbar bridge: launch {name}: {' '.join(command)}", flush=True)
    subprocess.Popen(command, cwd=home, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def handle_launch_request(path):
    if not os.path.exists(path):
        return
    try:
        stat_result = os.stat(path)
        if stat_result.st_uid != os.getuid() or not os.path.isfile(path):
            return
        with open(path, "r", encoding="utf-8") as handle:
            launcher = handle.read().strip().replace("\r", "")
    except OSError:
        return
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
    if launcher:
        launch_linux_app(launcher)


def build_payload():
    return {"version": 1, "timestamp": time.time(), "windows": sync_windows()}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--state", default="/tmp/reactos-taskbar-windows.json")
    parser.add_argument("--control", default="/tmp/reactos-taskbar-control.json")
    parser.add_argument("--launch-request", default=os.environ.get(
        "REACTOS_LAUNCH_REQUEST",
        os.path.expanduser("~/.wine/drive_c/cusdeb/launch-request"),
    ))
    parser.add_argument("--buttons", default=None,
                        help="sidecar JSON with exact taskbar button rects, "
                             "written by the ReactOS explorer")
    parser.add_argument("--interval", type=float, default=0.5,
                        help="window list sync interval, seconds")
    parser.add_argument("--control-interval", type=float, default=0.1,
                        help="control/launch file poll interval, seconds")
    parser.add_argument("--once", action="store_true")
    args = parser.parse_args()

    # _icon_dir/_buttons_path are module-level runtime settings; `global` is
    # required because main() assigns to them after parsing command-line
    # arguments.
    global _icon_dir, _buttons_path

    # Keep exported icons next to the state file: the ReactOS side reaches
    # them through Wine's Z: drive, which maps to the host filesystem root.
    _icon_dir = os.path.join(os.path.dirname(os.path.abspath(args.state)), "taskbar-icons")
    os.makedirs(_icon_dir, exist_ok=True)
    _buttons_path = args.buttons

    log_startup()

    while True:
        scan_and_normalize_windows()
        payload = build_payload()
        track_active_task_window(payload["windows"])
        write_atomic(args.state, payload)
        handle_control(args.control)
        handle_launch_request(args.launch_request)
        if args.once:
            break
        # Poll the control/launch files cheaply until the next window sync
        # is due, so taskbar clicks are handled within ~control-interval
        # instead of waiting a full sync cycle.
        deadline = time.monotonic() + args.interval
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            time.sleep(min(args.control_interval, remaining))
            handle_control(args.control)
            handle_launch_request(args.launch_request)


if __name__ == "__main__":
    main()
