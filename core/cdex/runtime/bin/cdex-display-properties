#!/bin/bash
set -euo pipefail

export WINEPREFIX="${WINEPREFIX:-$HOME/.wine}"
export WINEARCH=win64
export WINEDEBUG="${WINEDEBUG:--all}"
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}comctl32=b;uxtheme=b"

# The launcher's embedded manifest selects the private ReactOS assembly.
exec wine 'C:\reactos\control.exe' 'C:\reactos\desk.cpl'
