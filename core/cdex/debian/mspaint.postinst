#!/bin/sh
set -e

case "$1" in
    configure)
        /usr/share/cusdeb/cdex/cdex-shortcut-helper create \
            "-" \
            "Accessories\\Paint" \
            "C:\\reactos\\mspaint.exe" \
            "C:\\reactos" \
            "Paint"
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
