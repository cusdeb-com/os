--- a/src/dll/win32/shell32/shlexec.cpp
+++ b/src/dll/win32/shell32/shlexec.cpp
@@ -2725,6 +2725,8 @@
     HRESULT hrCoInit;
     DWORD dwError;
     ULONG fOldMask;
+    LPCWSTR originalFile;
+    WCHAR privateHost[MAX_PATH];
 
     if (sei->cbSize != sizeof(SHELLEXECUTEINFOW))
     {
@@ -2756,7 +2758,25 @@
     if (!(fOldMask & SEE_MASK_NOASYNC) && SHELL_InRunDllProcess())
         sei->fMask |= SEE_MASK_WAITFORINPUTIDLE | SEE_MASK_NOASYNC;
 
+    // Shell hosts must activate the same private assembly as this shell32.
+    // Do not alter ordinary application launches or explicit system paths.
+    originalFile = sei->lpFile;
+    if (!(sei->fMask & SEE_MASK_INVOKEIDLIST) && originalFile &&
+        (!lstrcmpiW(originalFile, L"explorer.exe") ||
+         !lstrcmpiW(originalFile, L"control.exe") ||
+         !lstrcmpiW(originalFile, L"rundll32.exe")))
+    {
+        DWORD length = GetModuleFileNameW(shell32_hInstance, privateHost, _countof(privateHost));
+        if (length && length < _countof(privateHost) &&
+            PathRemoveFileSpecW(privateHost) && PathAppendW(privateHost, originalFile) &&
+            PathFileExistsW(privateHost))
+        {
+            sei->lpFile = privateHost;
+        }
+    }
+
     dwError = ShellExecute_Normal(sei);
+    sei->lpFile = originalFile;
 
     if (dwError && dwError != ERROR_DLL_NOT_FOUND && dwError != ERROR_CANCELLED)
         ShellExecute_ShowError(sei, NULL, dwError);
