+static BOOL
+IsApplicationIconUsable(HICON hIcon, BOOL bLargeIcon)
+{
+    HICON hCopy;
+    INT nSize = bLargeIcon ? 32 : 16;
+
+    if (!hIcon)
+        return FALSE;
+
+    hCopy = (HICON)CopyImage(hIcon, IMAGE_ICON, nSize, nSize, 0);
+    if (!hCopy)
+        return FALSE;
+
+    DestroyIcon(hCopy);
+    return TRUE;
+}
+
+static HICON
+GetApplicationIcon(HWND hWnd, BOOL bLargeIcon, BOOL *pbIconOwned)
+{
+    HICON hIcon = NULL;
+    LRESULT bAlive;
+    DWORD dwProcessId;
+    DWORD dwLength;
+    LPWSTR pszExePath;
+    SHFILEINFOW shfi;
+
+    *pbIconOwned = FALSE;
+
+#define GET_ICON(type) \
+    SendMessageTimeoutW(hWnd, WM_GETICON, (type), 0, SMTO_ABORTIFHUNG, 100, (PDWORD_PTR)&hIcon)
+
+    bAlive = GET_ICON(bLargeIcon ? ICON_BIG : ICON_SMALL);
+    if (!IsApplicationIconUsable(hIcon, bLargeIcon))
+    {
+        hIcon = NULL;
+        if (bAlive)
+        {
+            GET_ICON(bLargeIcon ? ICON_SMALL : ICON_BIG);
+            if (!IsApplicationIconUsable(hIcon, bLargeIcon))
+                hIcon = NULL;
+        }
+
+        if (!hIcon)
+        {
+            hIcon = (HICON)(LONG_PTR)GetClassLongPtrW(hWnd,
+                                                       bLargeIcon ? GCL_HICON : GCL_HICONSM);
+            if (!IsApplicationIconUsable(hIcon, bLargeIcon))
+                hIcon = NULL;
+        }
+        if (!hIcon)
+        {
+            hIcon = (HICON)(LONG_PTR)GetClassLongPtrW(hWnd,
+                                                       bLargeIcon ? GCL_HICONSM : GCL_HICON);
+            if (!IsApplicationIconUsable(hIcon, bLargeIcon))
+                hIcon = NULL;
+        }
+    }
+
+#undef GET_ICON
+
+    /* Wine cannot marshal a cross-process HICON for WM_GETICON or
+     * GetClassLongPtrW. Use the executable's shell icon in that case. */
+    if (!hIcon && GetWindowThreadProcessId(hWnd, &dwProcessId))
+    {
+        dwLength = GetProcessExecutablePathById(dwProcessId, NULL, 0);
+        if (dwLength)
+        {
+            pszExePath = HeapAlloc(GetProcessHeap(), 0, dwLength * sizeof(WCHAR));
+            if (pszExePath)
+            {
+                if (GetProcessExecutablePathById(dwProcessId, pszExePath, dwLength))
+                {
+                    UINT iconFlags;
+
+                    memset(&shfi, 0, sizeof(shfi));
+
+                    iconFlags = SHGFI_ICON |
+                                (bLargeIcon ? SHGFI_LARGEICON : SHGFI_SMALLICON);
+
+                    if (SHGetFileInfoW(pszExePath,
+                                       0,
+                                       &shfi,
+                                       sizeof(shfi),
+                                       iconFlags))
+                    {
+                        if (shfi.hIcon)
+                        {
+                            hIcon = shfi.hIcon;
+                            *pbIconOwned = TRUE;
+                        }
+                    }
+                }
+
+                HeapFree(GetProcessHeap(), 0, pszExePath);
+            }
+        }
+    }
+
+    if (!hIcon)
+        hIcon = LoadIconW(hInst, bLargeIcon ? MAKEINTRESOURCEW(IDI_WINDOW) : MAKEINTRESOURCEW(IDI_WINDOWSM));
+
+    return hIcon;
+}
