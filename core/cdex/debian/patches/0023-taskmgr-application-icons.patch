+static void
+FreeApplicationPageListItem(LPAPPLICATION_PAGE_LIST_ITEM pData)
+{
+    if (!pData)
+        return;
+
+    if (pData->bIconOwned && pData->hIcon)
+        DestroyIcon(pData->hIcon);
+
+    HeapFree(GetProcessHeap(), 0, pData);
+}
