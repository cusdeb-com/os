Author: CusDeb OS Team
Description: Force the shell icon image lists (SIC_Initialize) to ILC_COLOR32,
 dropping the auto-detected Shell Icon BPP logic. Keeps icon alpha channels
 intact under Wine instead of degrading to lower color depths that lose
 transparency and produce black edges.
Last-Modified: Thu, 17 Sep 2026 14:04:41 +0300

--- a/src/dll/win32/shell32/iconcache.cpp
+++ b/src/dll/win32/shell32/iconcache.cpp
@@ -77,13 +77,6 @@ SIC_GetSmallIconSize(VOID)
     return (nIconSize > 0) ? nIconSize : nDefaultSize;
 }
 
-static INT
-SIC_GetIconBPP(VOID) // Bits Per Pixel
-{
-    INT nDefaultBPP = SHGetCurColorRes();
-    INT nIconBPP = SIC_GetMetricsValue(L"Shell Icon BPP", nDefaultBPP);
-    return (nIconBPP > 0) ? nIconBPP : nDefaultBPP;
-}
 
 /*****************************************************************************
  * SIC_CompareEntries
@@ -515,7 +508,6 @@ INT SIC_GetIconIndex (LPCWSTR sSourceFil
 BOOL SIC_Initialize(void)
 {
     HICON hSm = NULL, hLg = NULL;
-    INT bpp;
     DWORD ilMask;
     BOOL result = FALSE;
 
@@ -536,19 +528,10 @@ BOOL SIC_Initialize(void)
     ShellSmallIconSize = SIC_GetSmallIconSize();
     ShellLargeIconSize = SIC_GetLargeIconSize();
 
-    bpp = ShellIconBPP = SIC_GetIconBPP(); // Bits Per Pixel
-    if (bpp <= 4)
-        ilMask = ILC_COLOR4;
-    else if (bpp <= 8)
-        ilMask = ILC_COLOR8;
-    else if (bpp <= 16)
-        ilMask = ILC_COLOR16;
-    else if (bpp <= 24)
-        ilMask = ILC_COLOR24;
-    else if (bpp <= 32)
-        ilMask = ILC_COLOR32;
-    else
-        ilMask = ILC_COLOR;
+    /* Wine's virtual desktop is always true-color, so just force 32-bit
+     * color depth and skip the (here pointless) auto-detection. */
+    ShellIconBPP = 32;
+    ilMask = ILC_COLOR32;
 
     ilMask |= ILC_MASK;
 
