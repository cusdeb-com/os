 #include "precomp.h"
 
+/* Load a strip of toolbar images, each cx pixels wide at 96 DPI, with magenta as
+ * the transparent color. Above 96 DPI the strip is enlarged by a whole factor. */
+HIMAGELIST LoadToolbarImageList(UINT id, int cx)
+{
+    HINSTANCE hInst = _AtlBaseModule.GetResourceInstance();
+    int factor = GetDpiImageFactor();
+    BITMAP bm;
+
+    if (factor == 1)
+        return ImageList_LoadImageW(hInst, MAKEINTRESOURCEW(id), cx, 0, RGB(255, 0, 255),
+                                    IMAGE_BITMAP, LR_CREATEDIBSECTION);
+
+    HBITMAP hbm = (HBITMAP)LoadImageW(hInst, MAKEINTRESOURCEW(id), IMAGE_BITMAP, 0, 0, LR_CREATEDIBSECTION);
+    hbm = EnlargeBitmap(hbm, factor);
+    if (!hbm || !GetObjectW(hbm, sizeof(bm), &bm))
+        return NULL;
+
+    HIMAGELIST himl = ImageList_Create(cx * factor, bm.bmHeight, ILC_COLOR32 | ILC_MASK, 0, 0);
+    ImageList_AddMasked(himl, hbm, RGB(255, 0, 255));
+    DeleteObject(hbm);
+    return himl;
+}
+
 
