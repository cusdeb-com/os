+    PTASK_ITEM FindExternalTaskItem(IN LPCWSTR WindowId)
+    {
+        PTASK_ITEM TaskItem = m_TaskItems;
+        PTASK_ITEM LastItem = TaskItem + m_TaskItemCount;
+        while (TaskItem != LastItem)
+        {
+            if (TaskItem->IsExternal && !lstrcmpiW(TaskItem->ExternalWindowId, WindowId))
+                return TaskItem;
+            ++TaskItem;
+        }
+        return NULL;
+    }
+
+    BOOL AddOrUpdateExternalTask(IN LPCWSTR WindowId, IN LPCWSTR Title)
+    {
+        PTASK_ITEM TaskItem = FindExternalTaskItem(WindowId);
+        if (!TaskItem)
+        {
+            TRACE("Add external window %S\n", WindowId);
+            TaskItem = AllocTaskItem();
+            if (!TaskItem)
+                return FALSE;
+
+            ZeroMemory(TaskItem, sizeof(*TaskItem));
+            TaskItem->hWnd = NULL;
+            TaskItem->Index = -1;
+            TaskItem->IconIndex = -1;
+            TaskItem->IsExternal = TRUE;
+            StringCchCopyW(TaskItem->ExternalWindowId, _countof(TaskItem->ExternalWindowId), WindowId);
+            StringCchCopyW(TaskItem->ExternalTitle, _countof(TaskItem->ExternalTitle), Title);
+
+            if (!m_IsDestroying)
+                AddTaskItemButton(TaskItem);
+        }
+        else if (lstrcmpW(TaskItem->ExternalTitle, Title) != 0)
+        {
+            StringCchCopyW(TaskItem->ExternalTitle, _countof(TaskItem->ExternalTitle), Title);
+            if (TaskItem->Index >= 0)
+                UpdateTaskItemButton(TaskItem);
+        }
+
+        TaskItem->Seen = TRUE;
+        return TRUE;
+    }
+
+    VOID MarkExternalTasksUnseen()
+    {
+        PTASK_ITEM TaskItem = m_TaskItems;
+        PTASK_ITEM LastItem = TaskItem + m_TaskItemCount;
+        while (TaskItem != LastItem)
+        {
+            if (TaskItem->IsExternal)
+                TaskItem->Seen = FALSE;
+            ++TaskItem;
+        }
+    }
+
+    BOOL RemoveUnseenExternalTasks()
+    {
+        BOOL Removed = FALSE;
+        for (WORD i = 0; i < m_TaskItemCount;)
+        {
+            PTASK_ITEM TaskItem = m_TaskItems + i;
+            if (TaskItem->IsExternal && !TaskItem->Seen)
+            {
+                TRACE("Delete external window %S\n", TaskItem->ExternalWindowId);
+                DeleteTaskItem(TaskItem);
+                Removed = TRUE;
+                continue;
+            }
+            ++i;
+        }
+        return Removed;
+    }
+
+    VOID SyncExternalTasks()
+    {
+        CHeapPtr<CHAR> data;
+        DWORD cbData = 0;
+        if (!ReadWholeFile(g_szExternalTasksPath, data, cbData))
+        {
+            MarkExternalTasksUnseen();
+            RemoveUnseenExternalTasks();
+            return;
+        }
+
+        MarkExternalTasksUnseen();
+
+        const CHAR* cursor = data;
+        while ((cursor = strstr(cursor, "{\n")) != NULL)
+        {
+            const CHAR* objectEnd = strchr(cursor, '}');
+            if (!objectEnd)
+                break;
+
+            CHAR idA[32];
+            CHAR titleA[255];
+            WCHAR idW[32];
+            WCHAR titleW[255];
+            idA[0] = ANSI_NULL;
+            titleA[0] = ANSI_NULL;
+
+            if (FindJsonStringValue(cursor, objectEnd, "\"window_id\"", idA, _countof(idA)) &&
+                FindJsonStringValue(cursor, objectEnd, "\"title\"", titleA, _countof(titleA)))
+            {
+                Utf8ToWide(idA, idW, _countof(idW));
+                Utf8ToWide(titleA, titleW, _countof(titleW));
+                if (idW[0] && titleW[0])
+                    AddOrUpdateExternalTask(idW, titleW);
+            }
+
+            cursor = objectEnd + 1;
+        }
+
+        RemoveUnseenExternalTasks();
+    }
+
+    BOOL WriteExternalTaskCommand(IN LPCWSTR Action, IN LPCWSTR WindowId)
+    {
+        WCHAR json[256];
+        HRESULT hr = StringCchPrintfW(json, _countof(json),
+                                     L"{\"action\":\"%s\",\"window_id\":\"%s\"}\n",
+                                     Action, WindowId);
+        if (FAILED(hr))
+            return FALSE;
+
+        CHAR utf8[512];
+        INT cbUtf8 = WideCharToMultiByte(CP_UTF8, 0, json, -1, utf8, _countof(utf8), NULL, NULL);
+        if (!cbUtf8)
+            return FALSE;
+
+        HANDLE hFile = CreateFileW(g_szExternalTaskControlPath, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS,
+                                  FILE_ATTRIBUTE_NORMAL, NULL);
+        if (hFile == INVALID_HANDLE_VALUE)
+            return FALSE;
+
+        DWORD cbWritten = 0;
+        BOOL ok = WriteFile(hFile, utf8, cbUtf8 - 1, &cbWritten, NULL);
+        CloseHandle(hFile);
+        return ok;
+    }
