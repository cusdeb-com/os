+static WCHAR g_szExternalTasksPath[MAX_TASKBAR_PATH];
+static WCHAR g_szExternalTaskControlPath[MAX_TASKBAR_PATH];
+
+static void ConvertUnixToWinePath(LPCWSTR unixPath, LPWSTR winePath, SIZE_T cchWinePath)
+{
+    SIZE_T i = 0;
+    if (unixPath[0] == L'/')
+    {
+        if (i + 2 < cchWinePath)
+        {
+            winePath[i++] = L'Z';
+            winePath[i++] = L':';
+        }
+    }
+    for (LPCWSTR p = unixPath; *p && i + 1 < cchWinePath; ++p)
+    {
+        winePath[i++] = (*p == L'/') ? L'\\' : *p;
+    }
+    winePath[i] = UNICODE_NULL;
+}
+
+static void InitExternalTaskPaths()
+{
+    WCHAR buf[MAX_TASKBAR_PATH];
+    DWORD len;
+
+    len = GetEnvironmentVariableW(L"REACTOS_TASKBAR_STATE", buf, MAX_TASKBAR_PATH);
+    if (len == 0 || len >= MAX_TASKBAR_PATH)
+    {
+        StringCchCopyW(g_szExternalTasksPath, MAX_TASKBAR_PATH, L"Z:\\tmp\\reactos-taskbar-windows.json");
+    }
+    else
+    {
+        ConvertUnixToWinePath(buf, g_szExternalTasksPath, MAX_TASKBAR_PATH);
+    }
+
+    len = GetEnvironmentVariableW(L"REACTOS_TASKBAR_CONTROL", buf, MAX_TASKBAR_PATH);
+    if (len == 0 || len >= MAX_TASKBAR_PATH)
+    {
+        StringCchCopyW(g_szExternalTaskControlPath, MAX_TASKBAR_PATH, L"Z:\\tmp\\reactos-taskbar-control.json");
+    }
+    else
+    {
+        ConvertUnixToWinePath(buf, g_szExternalTaskControlPath, MAX_TASKBAR_PATH);
+    }
+}
 
