+    static BOOL ReadWholeFile(LPCWSTR path, CHeapPtr<CHAR>& data, DWORD& cbData)
+    {
+        cbData = 0;
+        HANDLE hFile = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                                  NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (hFile == INVALID_HANDLE_VALUE)
+            return FALSE;
+
+        DWORD cbSize = GetFileSize(hFile, NULL);
+        if (cbSize == INVALID_FILE_SIZE || cbSize == 0 || cbSize > 1024 * 1024)
+        {
+            CloseHandle(hFile);
+            return FALSE;
+        }
+
+        if (!data.AllocateBytes(cbSize + 1))
+        {
+            CloseHandle(hFile);
+            return FALSE;
+        }
+
+        DWORD cbRead = 0;
+        BOOL ok = ReadFile(hFile, data, cbSize, &cbRead, NULL);
+        CloseHandle(hFile);
+        if (!ok)
+            return FALSE;
+
+        data[cbRead] = ANSI_NULL;
+        cbData = cbRead;
+        return TRUE;
+    }
+
+    static const CHAR* FindJsonStringValue(const CHAR* objectStart, const CHAR* objectEnd, const CHAR* key,
+                                           CHAR* value, SIZE_T cchValue)
+    {
+        const CHAR* keyPos = strstr(objectStart, key);
+        if (!keyPos || keyPos >= objectEnd)
+            return NULL;
+
+        const CHAR* colon = strchr(keyPos, ':');
+        if (!colon || colon >= objectEnd)
+            return NULL;
+
+        const CHAR* quote = strchr(colon, '"');
+        if (!quote || quote >= objectEnd)
+            return NULL;
+        ++quote;
+
+        SIZE_T i = 0;
+        for (const CHAR* p = quote; *p && p < objectEnd; ++p)
+        {
+            if (*p == '"')
+            {
+                value[i] = ANSI_NULL;
+                return p + 1;
+            }
+            if (*p == '\\' && p + 1 < objectEnd)
+                ++p;
+            if (i + 1 < cchValue)
+                value[i++] = *p;
+        }
+        value[i] = ANSI_NULL;
+        return NULL;
+    }
+
+    static VOID Utf8ToWide(const CHAR* source, WCHAR* dest, INT cchDest)
+    {
+        if (!MultiByteToWideChar(CP_UTF8, 0, source, -1, dest, cchDest))
+        {
+            dest[0] = UNICODE_NULL;
+        }
+        dest[cchDest - 1] = UNICODE_NULL;
+    }
