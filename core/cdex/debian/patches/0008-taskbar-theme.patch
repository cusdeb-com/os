Author: CusDeb OS Team
Description: Change base/shell/explorer/taskswnd.cpp in several places. Disable native
 Windows task tracking in CTaskSwitchWnd so the taskbar relies entirely on
 external bridge tasks and no longer leaves stale buttons after windows close.
 Recalculate toolbar button spacing immediately after a theme change to prevent
 overlapping or stale metrics. Switch the taskbar image list from ILC_COLOR32 |
 ILC_MASK to ILC_COLOR24 | ILC_MASK to work around a Wine comctl32
 alpha-blending issue. Draw the taskbar background explicitly via
 DrawThemeBackground, without invalidating the toolbar afterward (which
 closed an infinite repaint loop with a themed TBSTYLE_TRANSPARENT toolbar).
Last-Modified: Tue, 18 Aug 2026 18:22:33 +0300

--- a/src/base/shell/explorer/taskswnd.cpp
+++ b/src/base/shell/explorer/taskswnd.cpp
@@ -1509,6 +1509,11 @@
         else
             m_Theme = NULL;
 
+        /* Recalculate button spacing immediately when the theme changes,
+           otherwise buttons overlap or retain stale metrics. */
+        m_TaskBar.UpdateTbButtonSpacing(m_Tray->IsHorizontal(), m_Theme != NULL);
+        UpdateButtonsSize(FALSE);
+
         return TRUE;
     }
 
@@ -1521,7 +1526,7 @@
 
         m_ImageList = ImageList_Create(GetSystemMetrics(g_TaskbarSettings.bSmallIcons ? SM_CXSMICON : SM_CXICON),
                                        GetSystemMetrics(g_TaskbarSettings.bSmallIcons ? SM_CYSMICON : SM_CYICON),
-                                       ILC_COLOR32 | ILC_MASK, 0, 1000);
+                                       ILC_COLOR24 | ILC_MASK, 0, 1000);
         m_TaskBar.SetImageList(m_ImageList);
 
         /* Set proper spacing between buttons */
@@ -2032,7 +2037,16 @@
 
         RECT rect;
         GetClientRect(&rect);
-        DrawThemeParentBackground(m_hWnd, hdc, &rect);
+        HTHEME hTheme = OpenThemeData(m_hWnd, L"TaskBar");
+        if (hTheme)
+        {
+            DrawThemeBackground(hTheme, hdc, TBP_BACKGROUNDBOTTOM, 0, &rect, NULL);
+            CloseThemeData(hTheme);
+        }
+        else
+        {
+            DrawThemeParentBackground(m_hWnd, hdc, &rect);
+        }
 
         return TRUE;
     }
