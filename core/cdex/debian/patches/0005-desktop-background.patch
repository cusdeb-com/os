                 m_ListView.SetTextColor(RGB(0, 0, 0));
@@ -1681,7 +1743,77 @@ LRESULT CDefView::OnEraseBackground(UINT
 {
     /* redirect to parent */
     if (m_FolderSettings.fFlags & (FWF_DESKTOP | FWF_TRANSPARENT))
+    {
+        HDC hdc = (HDC)wParam;
+
+        /* When the ListView background is CLR_NONE it skips its own erase;
+         * Windows sends WM_ERASEBKGND to the parent (this CDefView) instead.
+         * Draw the cached wallpaper here, otherwise fall back to the original
+         * behaviour and let CDesktopBrowser paint the solid colour. */
+        if (m_hWallpaperBitmap)
+        {
+            RECT rc;
+            GetClientRect(&rc);
+
+            HDC hMemDC = CreateCompatibleDC(hdc);
+            HBITMAP hOld = (HBITMAP)SelectObject(hMemDC, m_hWallpaperBitmap);
+
+            BITMAP bm;
+            ::GetObjectW(m_hWallpaperBitmap, sizeof(bm), &bm);
+
+            /* WallpaperStyle values used by Windows:
+             *   0, 1  = centred (default)
+             *   2     = stretch
+             *   6     = fit
+             *   10    = fill
+             * For simplicity we treat 2, 6 and 10 as "stretch to fill". */
+            WCHAR szStyle[8] = {0}, szTile[8] = {0};
+            DWORD cbStyle = sizeof(szStyle), cbTile = sizeof(szTile);
+            SHGetValueW(HKEY_CURRENT_USER, L"Control Panel\\Desktop", L"WallpaperStyle",
+                        NULL, szStyle, &cbStyle);
+            SHGetValueW(HKEY_CURRENT_USER, L"Control Panel\\Desktop", L"TileWallpaper",
+                        NULL, szTile, &cbTile);
+            int style = _wtoi(szStyle);
+            BOOL tile = _wtoi(szTile) != 0;
+
+            if (tile)
+            {
+                HBRUSH hBrush = CreateSolidBrush(GetSysColor(COLOR_DESKTOP));
+                FillRect(hdc, &rc, hBrush);
+                DeleteObject(hBrush);
+
+                for (int y = rc.top; y < rc.bottom; y += bm.bmHeight)
+                    for (int x = rc.left; x < rc.right; x += bm.bmWidth)
+                        BitBlt(hdc, x, y, bm.bmWidth, bm.bmHeight, hMemDC, 0, 0, SRCCOPY);
+            }
+            else if (style == 2 || style == 6 || style == 10)
+            {
+                /* HALFTONE looks much better than COLORONCOLOR when the image
+                 * is down-scaled (e.g. a 4K JPEG on a 1080p screen). */
+                SetStretchBltMode(hdc, HALFTONE);
+                StretchBlt(hdc, rc.left, rc.top, rc.right - rc.left, rc.bottom - rc.top,
+                           hMemDC, 0, 0, bm.bmWidth, bm.bmHeight, SRCCOPY);
+            }
+            else
+            {
+                HBRUSH hBrush = CreateSolidBrush(GetSysColor(COLOR_DESKTOP));
+                FillRect(hdc, &rc, hBrush);
+                DeleteObject(hBrush);
+
+                int x = rc.left + (rc.right - rc.left - bm.bmWidth) / 2;
+                int y = rc.top + (rc.bottom - rc.top - bm.bmHeight) / 2;
+                if (x < rc.left) x = rc.left;
+                if (y < rc.top) y = rc.top;
+                BitBlt(hdc, x, y, bm.bmWidth, bm.bmHeight, hMemDC, 0, 0, SRCCOPY);
+            }
+
+            SelectObject(hMemDC, hOld);
+            DeleteDC(hMemDC);
+            return TRUE;
+        }
+
         return SendMessageW(GetParent(), WM_ERASEBKGND, wParam, lParam);
+    }
 
     bHandled = FALSE;
     return 0;
