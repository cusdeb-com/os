@@ -939,12 +954,60 @@ void CDefView::UpdateListColors()
         BOOL bDropShadow = FALSE;
         DWORD cbDropShadow = sizeof(bDropShadow);
 
-        /*
-         * The desktop ListView always take the default desktop colours, by
-         * remaining transparent and letting user32/win32k paint itself the
-         * desktop background color, if any.
-         */
-        m_ListView.SetBkColor(CLR_NONE);
+        /* Wine caches system colours per-process.  desk.cpl updates the
+         * registry and broadcasts WM_SYSCOLORCHANGE, but Explorer still sees
+         * the old cached COLOR_DESKTOP.  Read the persisted value directly. */
+        COLORREF crDesktop = GetSysColor(COLOR_DESKTOP);
+        WCHAR szColor[32];
+        DWORD dwType, cbData = sizeof(szColor);
+        if (SHGetValueW(HKEY_CURRENT_USER, L"Control Panel\\Colors", L"Background",
+                        &dwType, szColor, &cbData) == ERROR_SUCCESS &&
+            dwType == REG_SZ)
+        {
+            WCHAR *pchEnd;
+            LONG r = wcstol(szColor, &pchEnd, 10);
+            if (pchEnd != szColor)
+            {
+                while (*pchEnd == L' ') ++pchEnd;
+                LONG g = wcstol(pchEnd, &pchEnd, 10);
+                while (*pchEnd == L' ') ++pchEnd;
+                LONG b = wcstol(pchEnd, &pchEnd, 10);
+                if (r >= 0 && r <= 255 && g >= 0 && g <= 255 && b >= 0 && b <= 255)
+                    crDesktop = RGB(r, g, b);
+            }
+        }
+
+        /* Load the wallpaper bitmap ourselves because Wine's PaintDesktop()
+         * does nothing in Explorer (the desktop window lives in wineserver).
+         * When a wallpaper is present we keep the ListView transparent
+         * (CLR_NONE) so the parent CDefView shows through; otherwise we paint
+         * the solid desktop colour directly.  The bitmap is loaded only once
+         * and reloaded only when OnSettingChange() detects SPI_SETDESKWALLPAPER. */
+        WCHAR szWallpaper[MAX_PATH];
+        DWORD cbWallpaper = sizeof(szWallpaper);
+        if (SHGetValueW(HKEY_CURRENT_USER, L"Control Panel\\Desktop", L"Wallpaper",
+                        NULL, szWallpaper, &cbWallpaper) == ERROR_SUCCESS &&
+            szWallpaper[0] != L'\0')
+        {
+            if (!m_hWallpaperBitmap)
+                m_hWallpaperBitmap = (HBITMAP)LoadImageW(NULL, szWallpaper, IMAGE_BITMAP, 0, 0, LR_LOADFROMFILE);
+
+            /* If loading failed (corrupt file, unsupported format) fall back
+             * to the solid desktop colour instead of a broken transparent bg. */
+            if (m_hWallpaperBitmap)
+                m_ListView.SetBkColor(CLR_NONE);
+            else
+                m_ListView.SetBkColor(crDesktop);
+        }
+        else
+        {
+            m_ListView.SetBkColor(crDesktop);
+            if (m_hWallpaperBitmap)
+            {
+                ::DeleteObject(m_hWallpaperBitmap);
+                m_hWallpaperBitmap = NULL;
+            }
+        }
 
         SHGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
                      L"ListviewShadow", NULL, &bDropShadow, &cbDropShadow);
