+static BOOL WriteCusdebPowerRequest(LPCSTR action)
+{
+    CHAR unixPath[MAX_PATH];
+    CHAR winePath[MAX_PATH];
+    DWORD len = GetEnvironmentVariableA("REACTOS_LAUNCH_REQUEST", unixPath, MAX_PATH);
+    if (len == 0 || len >= MAX_PATH)
+    {
+        /* Fallback to the legacy /tmp path if the runtime did not set the env var. */
+        LPCSTR fallback = "Z:\\tmp\\cusdeb-linux-launch-request.txt";
+        SIZE_T j = 0;
+        while (fallback[j] && j + 1 < MAX_PATH)
+        {
+            winePath[j] = fallback[j];
+            ++j;
+        }
+        winePath[j] = '\0';
+    }
+    else
+    {
+        SIZE_T i = 0;
+        if (unixPath[0] == '/')
+        {
+            if (i + 2 < MAX_PATH)
+            {
+                winePath[i++] = 'Z';
+                winePath[i++] = ':';
+            }
+        }
+        for (LPCSTR p = unixPath; *p && i + 1 < MAX_PATH; ++p)
+        {
+            winePath[i++] = (*p == '/') ? '\\' : *p;
+        }
+        winePath[i] = '\0';
+    }
+
+    HANDLE file = CreateFileA(winePath,
+                              GENERIC_WRITE,
+                              0,
+                              NULL,
+                              CREATE_ALWAYS,
+                              FILE_ATTRIBUTE_NORMAL,
+                              NULL);
+    if (file == INVALID_HANDLE_VALUE)
+        return FALSE;
+
+    DWORD written;
+    DWORD length = strlen(action);
+    BOOL ok = WriteFile(file, action, length, &written, NULL);
+    CloseHandle(file);
+    return ok && written == length;
+}
 
