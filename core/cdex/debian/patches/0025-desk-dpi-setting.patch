+/* CusDeb: the session sets the DPI at login. The choice made here is stored in
+ * C:\cusdeb\dpi; without that file the session detects the DPI itself. */
+#define DPI_CHOICE_FILE _T("C:\\cusdeb\\dpi")
+/* cdex-taskbar-bridge runs the action named in this file. */
+#define LAUNCH_REQUEST_FILE _T("C:\\cusdeb\\launch-request")
+
+/* The DPI values with their own artwork, set by the CDEX build. */
+static const UINT DpiSteps[] = { CDEX_DPI_STEPS };
+
+static UINT
+ReadDpiChoice(VOID)
+{
+    HANDLE hFile;
+    char Buffer[16];
+    DWORD Read = 0;
+
+    hFile = CreateFile(DPI_CHOICE_FILE, GENERIC_READ, FILE_SHARE_READ, NULL,
+                       OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (hFile == INVALID_HANDLE_VALUE)
+        return 0;
+    ReadFile(hFile, Buffer, sizeof(Buffer) - 1, &Read, NULL);
+    CloseHandle(hFile);
+    Buffer[Read] = '\0';
+    return (UINT)atoi(Buffer);
+}
