+static BOOL
+WriteTextFile(LPCTSTR Path, const char *Text)
+{
+    HANDLE hFile;
+    DWORD Written;
+    BOOL Ret;
+
+    CreateDirectory(_T("C:\\cusdeb"), NULL);
+    hFile = CreateFile(Path, GENERIC_WRITE, 0, NULL,
+                       CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (hFile == INVALID_HANDLE_VALUE)
+        return FALSE;
+    Ret = WriteFile(hFile, Text, strlen(Text), &Written, NULL);
+    CloseHandle(hFile);
+    return Ret;
