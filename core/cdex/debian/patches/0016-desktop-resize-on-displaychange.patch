+LRESULT CDesktopBrowser::OnDisplayChange(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL &bHandled)
+{
+    /* Do not resize right here: the taskbar has not recomputed the work area
+     * yet, so SPI_GETWORKAREA would return stale values and the synchronous
+     * broadcast would block on us. Defer the actual resize. */
+    m_uResizeRetry = 0;
+    SetRectEmpty(&m_rcLastWorkArea);
+    ::PostMessageW(m_hWnd, WM_DESKTOP_DEFERRED_RESIZE, 0, 0);
+    return 0;
+}
+
+LRESULT CDesktopBrowser::OnDeferredResize(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL &bHandled)
+{
+    /* The desktop window must resize itself when the display resolution changes,
+     * otherwise the work area used by the shell view becomes stale and a strip
+     * of the underlying window manager becomes visible.
+     * Right after a resolution change the taskbar recomputes the work area in
+     * several steps: it can be empty, then the full screen, and only then the
+     * final value minus the taskbar area. Resizing to an empty rect would
+     * collapse the desktop to a zero-size window, and resizing to the transient
+     * full-screen rect would cover the taskbar, so wait on a timer until the
+     * work area is both non-empty and stable across two reads. */
+    RECT rcWorkArea;
+    SystemParametersInfoW(SPI_GETWORKAREA, 0, &rcWorkArea, 0);
+
+    BOOL bEmpty = (rcWorkArea.right <= rcWorkArea.left || rcWorkArea.bottom <= rcWorkArea.top);
+    BOOL bStable = ::EqualRect(&rcWorkArea, &m_rcLastWorkArea);
+
+    if (bEmpty || !bStable)
+    {
+        m_rcLastWorkArea = rcWorkArea;
+        if (m_uResizeRetry < DESKTOP_RESIZE_RETRY_MAX)
+        {
+            m_uResizeRetry++;
+            ::SetTimer(m_hWnd, DESKTOP_RESIZE_RETRY_TIMER, DESKTOP_RESIZE_RETRY_MS, NULL);
+        }
+        /* When the budget runs out while the work area is still unsettled,
+         * leave the desktop at its current size rather than collapsing it. */
+        return 0;
+    }
+
+    ::KillTimer(m_hWnd, DESKTOP_RESIZE_RETRY_TIMER);
+    _Resize();
+    return 0;
+}
+
+LRESULT CDesktopBrowser::OnResizeRetryTimer(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL &bHandled)
+{
+    if (wParam == DESKTOP_RESIZE_RETRY_TIMER)
+    {
+        ::KillTimer(m_hWnd, DESKTOP_RESIZE_RETRY_TIMER);
+        ::PostMessageW(m_hWnd, WM_DESKTOP_DEFERRED_RESIZE, 0, 0);
+    }
+    return 0;
+}
