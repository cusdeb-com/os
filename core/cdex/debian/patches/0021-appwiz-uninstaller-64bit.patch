Author: Artem Lavrukhin <lavryha4590@gmail.com>
Description: Route Control Panel Add/Remove through Wine's application manager.
 ReactOS appwiz.cpl delegates to RAPPS, which is not shipped with CDEX.
 Launch Wine's system32 uninstaller directly on x64; when called through
 WOW64, it restarts as a 64-bit process to access both registry views.
Last-Modified: Fri, 20 Nov 2026 15:08:55 +0300

--- a/src/dll/win32/shell32/folders/CControlPanelFolder.cpp
+++ b/src/dll/win32/shell32/folders/CControlPanelFolder.cpp
@@ -745,2 +745,14 @@
     {
+        PCWSTR pszCplName = wcsrchr(pCPanel->szName, L'\\');
+        pszCplName = pszCplName ? pszCplName + 1 : pCPanel->szName;
+
+        if (!lstrcmpiW(pszCplName, L"appwiz.cpl"))
+        {
+            /* ReactOS appwiz requires RAPPS; use Wine's application manager. */
+            HINSTANCE hinst = ShellExecuteW(NULL, L"open", L"C:\\windows\\system32\\uninstaller.exe", NULL, NULL, SW_SHOWNORMAL);
+            if ((INT_PTR)hinst <= 32)
+                return hinst ? HRESULT_FROM_WIN32((DWORD)(INT_PTR)hinst) : E_FAIL;
+            return S_OK;
+        }
+
         /* Hardcode the command here; Executing a cpl file would be fine but we also need to run things like console.dll */
