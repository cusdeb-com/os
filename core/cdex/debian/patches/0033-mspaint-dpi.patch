+// The tool icons drawn for a higher DPI are 32-bit strips with an alpha
+// channel. A screen DPI below the lowest of them uses the 16 pixel strip.
+static HIMAGELIST LoadToolIcons()
+{
+    INT dpi = FindDpiBitmap(g_hinstExe, IDB_TOOLBARICONS_DPI(0));
+    HBITMAP hbmIcons = NULL;
+    BITMAP bm;
+
+    if (dpi > USER_DEFAULT_SCREEN_DPI)
+    {
+        hbmIcons = (HBITMAP)::LoadImageW(g_hinstExe, MAKEINTRESOURCEW(IDB_TOOLBARICONS_DPI(dpi)),
+                                         IMAGE_BITMAP, 0, 0, LR_CREATEDIBSECTION);
+    }
+    if (!hbmIcons || !::GetObjectW(hbmIcons, sizeof(bm), &bm))
+        return LoadToolbarIcons(IDB_TOOLBARICONS, NUM_TOOLS);
+
+    HIMAGELIST hImageList = ImageList_Create(bm.bmHeight, bm.bmHeight, ILC_COLOR32, NUM_TOOLS, 0);
+    ImageList_Add(hImageList, hbmIcons, NULL);
+    ::DeleteObject(hbmIcons);
+    return hImageList;
+}
