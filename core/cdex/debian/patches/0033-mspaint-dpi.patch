 /* FUNCTIONS ********************************************************/
 
+// Load a strip of 16 pixel toolbar icons with magenta as the transparent
+// color. Above 96 DPI the icons are enlarged by a whole factor.
+HIMAGELIST LoadToolbarIcons(UINT nID, INT cIcons)
+{
+    INT factor = GetDpiImageFactor();
+    HIMAGELIST hImageList = ImageList_Create(16 * factor, 16 * factor, ILC_COLOR24 | ILC_MASK, cIcons, 0);
+    HBITMAP hbmIcons = EnlargeBitmap(::LoadBitmapW(g_hinstExe, MAKEINTRESOURCEW(nID)), factor);
+
+    ImageList_AddMasked(hImageList, hbmIcons, RGB(255, 0, 255));
+    ::DeleteObject(hbmIcons);
+    return hImageList;
+}
