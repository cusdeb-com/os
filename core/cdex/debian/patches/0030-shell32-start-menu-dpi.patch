Author: CusDeb OS Team
Description: shell32: Scale the Start menu item metrics to the DPI.
 The item padding, the list gap, the space for the submenu arrow and the
 arrow itself were fixed pixel values. The arrow uses a Marlett font
 created with height 0, which is 16 pixels at any DPI, so at 192 DPI the
 arrows were tiny and the items cramped. Scale them to the screen DPI; 96
 DPI is unchanged.
Last-Modified: Thu, 12 Nov 2026 19:29:05 +0300

--- a/src/dll/win32/shell32/shellmenu/CMenuBand.cpp
+++ b/src/dll/win32/shell32/shellmenu/CMenuBand.cpp
@@ -21,6 +21,7 @@
 #include <windowsx.h>
 #include <commoncontrols.h>
 #include <shlwapi_undoc.h>
+#include <dpiscale.h>
 
 #include "CMenuBand.h"
 #include "CMenuToolbars.h"
@@ -368,9 +369,9 @@
 
     if (m_dwFlags & SMINIT_VERTICAL)
     {
-        pdbi->ptMinSize.x = max(minStatic.cx, minShlFld.cx) + 20;
+        pdbi->ptMinSize.x = max(minStatic.cx, minShlFld.cx) + ScaleToDpi(20);
         pdbi->ptMinSize.y = minStatic.cy + minShlFld.cy;
-        pdbi->ptMaxSize.x = max(maxStatic.cx, maxShlFld.cx) + 20;
+        pdbi->ptMaxSize.x = max(maxStatic.cx, maxShlFld.cx) + ScaleToDpi(20);
         pdbi->ptMaxSize.y = maxStatic.cy + maxShlFld.cy;
         pdbi->dwModeFlags = DBIMF_VARIABLEHEIGHT;
     }
