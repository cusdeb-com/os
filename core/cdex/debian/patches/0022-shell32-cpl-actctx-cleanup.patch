Author: Artem Lavrukhin <lavryha4590@gmail.com>
Description: Clean up the CPL activation context when loading fails.
 Deactivate the context if it was activated and release it if it was created.
 Initialize the activation flag for error paths before context creation.
Last-Modified: Thu, 12 Nov 2026 20:40:24 +0300

--- a/src/dll/win32/shell32/wine/control.c
+++ b/src/dll/win32/shell32/wine/control.c
@@ -65,3 +65,3 @@
     ULONG_PTR cookie;
-    BOOL bActivated;
+    BOOL bActivated = FALSE;
     WCHAR fileBuffer[MAX_PATH];
@@ -209,2 +209,8 @@
     FreeLibrary(applet->hModule);
+#ifdef __REACTOS__
+    if (bActivated)
+        DeactivateActCtx(0, cookie);
+    if (applet->hActCtx && applet->hActCtx != INVALID_HANDLE_VALUE)
+        ReleaseActCtx(applet->hActCtx);
+#endif
     HeapFree(GetProcessHeap(), 0, applet->cmd);
