+/*
+ * Rewrite a bare "explorer.exe" command in-place to the CDEX ReactOS
+ * Explorer path. The function preserves the original arguments and quotes,
+ * changes nothing for other executables, and leaves the command unchanged if
+ * the destination buffer is too small. It only rewrites the command text; it
+ * does not launch the process.
+ */
+static void SHELL_ResolveCDEXExplorerCommand(LPWSTR command, DWORD cchCommand)
+{
+    static const WCHAR explorerPath[] = L"C:\\reactos\\explorer.exe";
+    WCHAR executable[MAX_PATH];
+    LPWSTR tokenStart, tokenEnd;
+    SIZE_T tokenLength, commandLength, replacementLength;
+
+    if (!command || !cchCommand)
+        return;
+
+    tokenStart = command;
+    while (*tokenStart == L' ' || *tokenStart == L'\t')
+        ++tokenStart;
+
+    if (*tokenStart == L'\"')
+    {
+        ++tokenStart;
+        tokenEnd = strchrW(tokenStart, L'\"');
+    }
+    else
+    {
+        tokenEnd = tokenStart;
+        while (*tokenEnd && *tokenEnd != L' ' && *tokenEnd != L'\t')
+            ++tokenEnd;
+    }
+
+    if (!tokenEnd)
+        return;
+
+    tokenLength = tokenEnd - tokenStart;
+    if (tokenLength >= _countof(executable))
+        return;
+
+    memcpy(executable, tokenStart, tokenLength * sizeof(*executable));
+    executable[tokenLength] = UNICODE_NULL;
+    if (lstrcmpiW(executable, L"explorer.exe") && lstrcmpiW(executable, L"explorer"))
+        return;
+
+    commandLength = lstrlenW(command);
+    replacementLength = _countof(explorerPath) - 1;
+    if (commandLength - tokenLength + replacementLength + 1 > cchCommand)
+    {
+        ERR("CDEX explorer command buffer is too small\n");
+        return;
+    }
+
+    memmove(tokenStart + replacementLength, tokenEnd,
+            (commandLength - (tokenEnd - command) + 1) * sizeof(*command));
+    memcpy(tokenStart, explorerPath, replacementLength * sizeof(*command));
+}
