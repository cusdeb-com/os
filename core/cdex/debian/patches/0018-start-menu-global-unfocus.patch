 LRESULT CMenuDeskBar::_OnAppActivate(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL &bHandled)
 {
-#if 0
-    if (wParam == 0 && m_Shown)
+    // CusDeb: close the start menu when the app really loses activation to a
+    // window outside the menu hierarchy. We cannot rely solely on the thread
+    // local WH_GETMESSAGE hook because it does not see clicks in windows that
+    // belong to other threads/processes. WM_ACTIVATEAPP is the cross-thread
+    // signal, but Wine/ReactOS also emits spurious deactivation events while
+    // the menu is still in use. Therefore we arm a short timer and check the
+    // actual foreground window only after the dust settles.
+    if (wParam == 0)
     {
-        OnSelect(MPOS_FULLCANCEL);
+        if (m_hWnd && m_Shown)
+            SetTimer(IDT_CUSDEB_ACTIVATECHECK, 50);
+    }
+    else
+    {
+        KillTimer(IDT_CUSDEB_ACTIVATECHECK);
+    }
+
+    return 0;
+}
+
+LRESULT CMenuDeskBar::_OnTimer(UINT uMsg, WPARAM wParam, LPARAM lParam, BOOL &bHandled)
+{
+    if (wParam != IDT_CUSDEB_ACTIVATECHECK)
+    {
+        bHandled = FALSE;
+        return 0;
     }
-#endif
+
+    // Prevent re-entrant close: IsTrackedWindowOrParent and other COM calls
+    // below may pump messages or call back into this DeskBar and close it.
+    if (m_InUnfocusCheck)
+        return 0;
+    m_InUnfocusCheck = TRUE;
+
+    KillTimer(IDT_CUSDEB_ACTIVATECHECK);
+
+    if (!m_Shown || !m_hWnd)
+    {
+        m_InUnfocusCheck = FALSE;
+        return 0;
+    }
+
+    HWND fg = ::GetForegroundWindow();
+    if (fg == NULL || fg == m_hWnd)
+    {
+        m_InUnfocusCheck = FALSE;
+        return 0;
+    }
+
+    if (_IsSubMenuParent(fg))
+    {
+        m_InUnfocusCheck = FALSE;
+        return 0;
+    }
+
+    CMenuFocusManager *mgr = CMenuFocusManager::GetManager();
+    if (mgr && mgr->IsTrackedWindowOrParent(fg) == S_OK)
+    {
+        m_InUnfocusCheck = FALSE;
+        return 0;
+    }
+
+    // Top-level menu: the tray/taskbar window is also considered "ours".
+    if (!m_SubMenuParent && m_Site)
+    {
+        CComPtr<IOleWindow> siteWnd;
+        if (SUCCEEDED(m_Site->QueryInterface(IID_PPV_ARG(IOleWindow, &siteWnd))))
+        {
+            HWND owner;
+            if (SUCCEEDED(siteWnd->GetWindow(&owner)) && fg == owner)
+            {
+                m_InUnfocusCheck = FALSE;
+                return 0;
+            }
+        }
+    }
+
+    // Re-check state in case a nested close happened above.
+    if (m_Shown && m_hWnd)
+        OnSelect(MPOS_FULLCANCEL);
+
+    m_InUnfocusCheck = FALSE;
     return 0;
 }
 
