+/* Load the Start menu banner for the screen DPI. A DPI without its own
+ * artwork scales that of the nearest smaller one, by pixel replication when
+ * the factor is a whole number and with filtering otherwise. */
+static HBITMAP LoadStartMenuBanner(VOID)
+{
+    HDC hdcScreen = GetDC(NULL);
+    int dpi = GetScreenDpi(), base = FindDpiBitmap(hExplorerInstance, IDB_STARTMENU_DPI(0));
+    HBITMAP hbm;
+    BITMAP bm;
+
+    hbm = LoadBitmapW(hExplorerInstance, MAKEINTRESOURCEW(base > USER_DEFAULT_SCREEN_DPI
+                                                          ? IDB_STARTMENU_DPI(base) : IDB_STARTMENU));
+    if (hbm && dpi != base && GetObjectW(hbm, sizeof(bm), &bm))
+    {
+        int cx = MulDiv(bm.bmWidth, dpi, base);
+        int cy = MulDiv(bm.bmHeight, dpi, base);
+        HBITMAP hbmScaled = CreateCompatibleBitmap(hdcScreen, cx, cy);
+        HDC hdcSrc = CreateCompatibleDC(hdcScreen);
+        HDC hdcDst = CreateCompatibleDC(hdcScreen);
+
+        if (hbmScaled)
+        {
+            HGDIOBJ hbmOldSrc = SelectObject(hdcSrc, hbm);
+            HGDIOBJ hbmOldDst = SelectObject(hdcDst, hbmScaled);
+
+            SetStretchBltMode(hdcDst, dpi % base ? HALFTONE : COLORONCOLOR);
+            SetBrushOrgEx(hdcDst, 0, 0, NULL);
+            StretchBlt(hdcDst, 0, 0, cx, cy, hdcSrc, 0, 0, bm.bmWidth, bm.bmHeight, SRCCOPY);
+            SelectObject(hdcSrc, hbmOldSrc);
+            SelectObject(hdcDst, hbmOldDst);
+            DeleteObject(hbm);
+            hbm = hbmScaled;
+        }
+        DeleteDC(hdcSrc);
+        DeleteDC(hdcDst);
+    }
+    ReleaseDC(NULL, hdcScreen);
+    return hbm;
+}
+
 #define AUTOHIDE_SPEED_SHOW 10
 #define AUTOHIDE_SPEED_HIDE 1
 
