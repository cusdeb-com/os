Author: CusDeb OS Team
Description: Bypass SHFindFiles for the Start Menu Search button under Wine. ReactOS
 shell32's SHFindFiles returns FALSE under Wine even though the ShellExecuteW
 call it internally performs succeeds. Directly launching
 C:\reactos\filebrowser.exe with the Search Results Folder CLSID opens the
 search window reliably from the tray window process.
Last-Modified: Mon, 13 Jul 2026 19:30:09 +0300

--- a/reactos-src/base/shell/explorer/traywnd.cpp
+++ b/reactos-src/base/shell/explorer/traywnd.cpp
@@ -858,8 +858,20 @@ public:
                 break;
             case IDM_SEARCH:
             case TRAYCMD_SEARCH_FILES:
-                SHFindFiles(NULL, NULL);
+            {
+                // CusDeb: bypass SHFindFiles under Wine because ReactOS shell32's
+                // SHFindFiles returns FALSE even though ShellExecuteW succeeds.
+                STARTUPINFOW si = { sizeof(si) };
+                PROCESS_INFORMATION pi = { 0 };
+                WCHAR szCmdLine[] = L"C:\\reactos\\filebrowser.exe ::{E17D4FC0-5564-11D1-83F2-00A0C90DC849}";
+                if (CreateProcessW(L"C:\\reactos\\filebrowser.exe", szCmdLine,
+                                   NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi))
+                {
+                    CloseHandle(pi.hProcess);
+                    CloseHandle(pi.hThread);
+                }
                 break;
+            }
             case TRAYCMD_SEARCH_COMPUTERS:
                 SHFindComputer(NULL, NULL);
                 break;
