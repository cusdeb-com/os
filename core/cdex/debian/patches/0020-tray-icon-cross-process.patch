+static BOOL GetSerializedTrayIconSize(_In_ CONST TRAYNOTIFYICONINFO *iconInfo, _Out_ SIZE_T *size)
+{
+    ULONGLONG total;
+
+    if (!iconInfo->width || !iconInfo->height || iconInfo->width > 512 || iconInfo->height > 512 ||
+        !iconInfo->planes || !iconInfo->bpp || iconInfo->planes > 255 || iconInfo->bpp > 255 ||
+        !iconInfo->maskSize || !iconInfo->colorSize)
+        return FALSE;
+
+    total = (ULONGLONG)iconInfo->maskSize + iconInfo->colorSize;
+    if (total > 32 * 1024 * 1024)
+        return FALSE;
+
+    ULONGLONG maskMinimum = ((ULONGLONG)iconInfo->width + 15) / 16 * 2 * iconInfo->height;
+    ULONGLONG colorMinimum = ((ULONGLONG)iconInfo->width * iconInfo->planes * iconInfo->bpp + 15) /
+                            16 * 2 * iconInfo->height;
+    if (iconInfo->maskSize < maskMinimum || iconInfo->colorSize < colorMinimum)
+        return FALSE;
+
+    *size = (SIZE_T)total;
+    return TRUE;
+}
+
+static BOOL CreateTrayIconFromPayload(_In_ CONST TRAYNOTIFYICONINFO *iconInfo,
+                                      _Inout_ CONST BYTE **data,
+                                      _Inout_ SIZE_T *available,
+                                      _Out_ HICON *icon)
+{
+    SIZE_T size;
+
+    *icon = NULL;
+    if (!GetSerializedTrayIconSize(iconInfo, &size) || size > *available)
+        return FALSE;
+
+    *icon = CreateIcon(NULL, iconInfo->width, iconInfo->height,
+                       (BYTE)iconInfo->planes, (BYTE)iconInfo->bpp,
+                       *data, *data + iconInfo->maskSize);
+    if (!*icon)
+        return FALSE;
+
+    *data += size;
+    *available -= size;
+    return TRUE;
+}
+
+static BOOL DeserializeTrayNotification(_In_ CONST COPYDATASTRUCT *copyData,
+                                        _In_ CONST TRAYNOTIFYDATAW_V2 *wireData,
+                                        _Out_ NOTIFYICONDATAW *iconData,
+                                        _Out_ BOOL *ownIcon)
+{
+    SIZE_T available;
+    const BYTE *data;
+
+    if (copyData->cbData < FIELD_OFFSET(TRAYNOTIFYDATAW_V2, icon_data))
+        return FALSE;
+
+    available = copyData->cbData - FIELD_OFFSET(TRAYNOTIFYDATAW_V2, icon_data);
+    data = wireData->icon_data;
+    *ownIcon = FALSE;
+    ZeroMemory(iconData, sizeof(*iconData));
+
+    iconData->cbSize = sizeof(*iconData);
+    iconData->hWnd = (HWND)(ULONG_PTR)(ULONG)wireData->hWnd;
+    iconData->uID = wireData->uID;
+    iconData->uFlags = wireData->uFlags;
+    iconData->uCallbackMessage = wireData->uCallbackMessage;
+    iconData->dwState = wireData->dwState & ~NIS_SHAREDICON;
+    iconData->dwStateMask = wireData->dwStateMask & ~NIS_SHAREDICON;
+    iconData->uTimeout = wireData->u.uTimeout;
+    iconData->dwInfoFlags = wireData->dwInfoFlags;
+    iconData->guidItem = wireData->guidItem;
+    lstrcpynW(iconData->szTip, wireData->szTip, _countof(iconData->szTip));
+    lstrcpynW(iconData->szInfo, wireData->szInfo, _countof(iconData->szInfo));
+    lstrcpynW(iconData->szInfoTitle, wireData->szInfoTitle, _countof(iconData->szInfoTitle));
+
+    if (iconData->uFlags & NIF_ICON)
+    {
+        if (!CreateTrayIconFromPayload(&wireData->icon_info, &data, &available, &iconData->hIcon))
+            goto failed;
+        *ownIcon = TRUE;
+    }
+
+    return TRUE;
+
+failed:
+    if (*ownIcon)
+    {
+        DestroyIcon(iconData->hIcon);
+        iconData->hIcon = NULL;
+        *ownIcon = FALSE;
+    }
+    return FALSE;
+}
+
+static BOOL CreateWineTrayIcon(const WineTrayIconInfo& info, const BYTE **data,
+                               SIZE_T *available, HICON *icon)
+{
+    if (!info.width || !info.height || info.width > 512 || info.height > 512 ||
+        !info.planes || info.planes > 255 || !info.bpp || info.bpp > 255)
+        return FALSE;
+    TRAYNOTIFYICONINFO converted = {0};
+    converted.width = info.width;
+    converted.height = info.height;
+    converted.planes = info.planes;
+    converted.bpp = info.bpp;
+    ULONGLONG mask = ((ULONGLONG)info.width * info.height + 15) / 16 * 2;
