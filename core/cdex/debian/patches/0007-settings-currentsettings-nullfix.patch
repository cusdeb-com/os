Author: CusDeb OS Team
Description: Change dll/cpl/desk/settings.c to add a fallback in GetPossibleSettings when
 *CurrentSettings is NULL. Under Wine, GetDeviceCaps and EnumDisplaySettingsEx
 can return inconsistent values, so the exact-match search for the current mode
 may fail. Without the fallback, AddDisplayDevice dereferences a NULL pointer
 when accessing newEntry->CurrentSettings->dmPelsWidth, crashing the Settings
 tab in desk.cpl.
Last-Modified: Mon, 13 Jul 2026 19:30:09 +0300

--- a/src/dll/cpl/desk/settings.c
+++ b/src/dll/cpl/desk/settings.c
@@ -164,6 +164,9 @@ GetPossibleSettings(IN LPCTSTR DeviceNam
     }
 
     *pSettingsCount = NbSettings;
+
+    if (*CurrentSettings == NULL && Settings != NULL)
+        *CurrentSettings = Settings;
     return Settings;
 }
 
