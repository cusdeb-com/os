+    /* External task icons come from a .ico file the bridge exports for the
+       host window. The file name contains a content hash, so a changed path
+       means a changed icon; the HICON is cached per task item. LoadImage is
+       used instead of ExtractIconEx because the shell32 icon cache returns
+       a poorly downscaled large icon instead of the real small one. The
+       path is only marked as loaded on success: the bridge may rewrite the
+       file a poll later, so a failed load must be retried on the next sync
+       instead of sticking with the fallback icon forever. */
+    HICON GetExternalTaskIcon(IN PTASK_ITEM TaskItem)
+    {
+        if (!TaskItem->ExternalIconPath[0])
+            return NULL;
+
+        if (!TaskItem->hExternalIcon ||
+            lstrcmpW(TaskItem->ExternalIconLoaded, TaskItem->ExternalIconPath) != 0)
+        {
+            INT size;
+            HICON hIcon;
+
+            if (TaskItem->hExternalIcon)
+            {
+                DestroyIcon(TaskItem->hExternalIcon);
+                TaskItem->hExternalIcon = NULL;
+            }
+
+            size = GetSystemMetrics(g_TaskbarSettings.bSmallIcons ? SM_CXSMICON : SM_CXICON);
+            hIcon = (HICON)LoadImageW(NULL, TaskItem->ExternalIconPath,
+                                      IMAGE_ICON, size, size,
+                                      LR_LOADFROMFILE);
+            if (hIcon)
+            {
+                TaskItem->hExternalIcon = hIcon;
+                StringCchCopyW(TaskItem->ExternalIconLoaded,
+                               _countof(TaskItem->ExternalIconLoaded),
+                               TaskItem->ExternalIconPath);
+            }
+        }
+
+        return TaskItem->hExternalIcon;
+    }
