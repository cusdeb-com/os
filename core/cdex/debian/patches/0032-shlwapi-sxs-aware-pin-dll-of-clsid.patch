+enum shpin_sxs_result
+{
+    SHPIN_SXS_ERROR,
+    SHPIN_SXS_NOT_FOUND,
+    SHPIN_SXS_FOUND
+};
+
+/* Resolve using Wine 11.19's private COM-redirection data. On success, the
+ * caller owns the returned path and must free it with HeapFree. Only a missing
+ * class permits registry fallback; other failures leave an error in LastError. */
+static enum shpin_sxs_result SHResolveActCtxComServer(REFIID clsid, WCHAR **resolved_dll_path)
+{
+    ACTCTX_SECTION_KEYED_DATA com_data;
+    ACTCTX_SECTION_KEYED_DATA dll_data;
+    PACTIVATION_CONTEXT_DATA_DLL_REDIRECTION dll_redirect;
+    LPCWSTR module_name;
+    WCHAR resolved_path[MAX_PATH];
+    ULONG_PTR cookie;
+    DWORD error, path_len;
+    enum shpin_sxs_result result = SHPIN_SXS_ERROR;
+    BOOL actctx_active = FALSE;
+
+    *resolved_dll_path = NULL;
+    memset(&com_data, 0, sizeof(com_data));
+    memset(&dll_data, 0, sizeof(dll_data));
+    com_data.cbSize = sizeof(com_data);
+    dll_data.cbSize = sizeof(dll_data);
+
+    if (!FindActCtxSectionGuid(FIND_ACTCTX_SECTION_KEY_RETURN_HACTCTX, NULL,
+                               ACTIVATION_CONTEXT_SECTION_COM_SERVER_REDIRECTION,
+                               clsid, &com_data))
+    {
+        error = GetLastError();
+        if (error == ERROR_SXS_KEY_NOT_FOUND)
+            return SHPIN_SXS_NOT_FOUND;
+        SetLastError(error);
+        return SHPIN_SXS_ERROR;
+    }
+
+    if (!com_data.hActCtx)
+    {
+        error = ERROR_INVALID_DATA;
+        goto done;
+    }
+    error = SHPinParseActCtxComServer(&com_data, clsid, &module_name);
+    if (error != ERROR_SUCCESS)
+        goto done;
+
+    if (!ActivateActCtx(com_data.hActCtx, &cookie))
+    {
+        error = GetLastError();
+        goto done;
+    }
+    actctx_active = TRUE;
+
+    if (!FindActCtxSectionString(FIND_ACTCTX_SECTION_KEY_RETURN_HACTCTX, NULL,
+                                 ACTIVATION_CONTEXT_SECTION_DLL_REDIRECTION,
+                                 module_name, &dll_data))
+    {
+        error = GetLastError();
+        goto done;
+    }
+    if (!dll_data.hActCtx || dll_data.ulDataFormatVersion != 1 ||
+        dll_data.ulLength < sizeof(*dll_redirect) ||
+        (ULONG_PTR)dll_data.lpData % sizeof(ULONG) ||
+        !SHPinActCtxRangeValid(dll_data.lpSectionBase, dll_data.ulSectionTotalLength,
+                               dll_data.lpData, dll_data.ulLength) ||
+        dll_data.ulAssemblyRosterIndex != com_data.ulAssemblyRosterIndex)
+    {
+        error = ERROR_INVALID_DATA;
+        goto done;
+    }
+    dll_redirect = dll_data.lpData;
+    if (dll_redirect->Size < sizeof(*dll_redirect) || dll_redirect->Size > dll_data.ulLength)
+    {
+        error = ERROR_INVALID_DATA;
+        goto done;
+    }
+
+    /* SearchPathW resolves the name through the activated DLL-redirection section. */
+    path_len = SearchPathW(NULL, module_name, L".dll", ARRAY_SIZE(resolved_path),
+                           resolved_path, NULL);
+    if (!path_len || path_len >= ARRAY_SIZE(resolved_path))
+    {
+        error = path_len ? ERROR_INSUFFICIENT_BUFFER : GetLastError();
+        goto done;
+    }
+
+    *resolved_dll_path = HeapAlloc(GetProcessHeap(), 0, ((SIZE_T)path_len + 1) * sizeof(WCHAR));
+    if (!*resolved_dll_path)
+    {
+        error = ERROR_NOT_ENOUGH_MEMORY;
+        goto done;
+    }
+    CopyMemory(*resolved_dll_path, resolved_path, ((SIZE_T)path_len + 1) * sizeof(WCHAR));
+    result = SHPIN_SXS_FOUND;
+
+done:
+    if (actctx_active && !DeactivateActCtx(0, cookie))
+    {
+        error = GetLastError();
+        result = SHPIN_SXS_ERROR;
+    }
+    if (dll_data.hActCtx)
+        ReleaseActCtx(dll_data.hActCtx);
+    if (com_data.hActCtx)
+        ReleaseActCtx(com_data.hActCtx);
+    if (result == SHPIN_SXS_ERROR)
+    {
+        if (*resolved_dll_path)
+            HeapFree(GetProcessHeap(), 0, *resolved_dll_path);
+        *resolved_dll_path = NULL;
+        SetLastError(error);
+    }
+    return result;
+}
