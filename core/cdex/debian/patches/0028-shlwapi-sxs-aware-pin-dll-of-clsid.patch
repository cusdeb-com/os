+++ b/src/dll/win32/shlwapi/sxsactctx.h
@@ -0,0 +1,127 @@
+/*
+ * Copyright 2026 CusDeb OS Team
+ *
+ * SxS COM-redirection data shared with the SHPinDllOfCLSID tests.
+ * The private record layout mirrors Wine's comclassredirect_data in
+ * dlls/ntdll/actctx.c. Keep tools/tests/test_shpin_actctx_abi.py in sync.
+ */
+
+#ifndef __SHLWAPI_SXSACTCTX_H
+#define __SHLWAPI_SXSACTCTX_H
+
+#include <string.h>
+
+struct shpin_comclassredirect_data
+{
+    ULONG size;
+    ULONG flags;
+    DWORD model;
+    GUID clsid;
+    GUID alias;
+    GUID clsid2;
+    GUID tlbid;
+    ULONG name_len;
+    ULONG name_offset;
+    ULONG progid_len;
+    ULONG progid_offset;
+    ULONG clrdata_len;
+    ULONG clrdata_offset;
+    DWORD miscstatus;
+    DWORD miscstatuscontent;
+    DWORD miscstatusthumbnail;
+    DWORD miscstatusicon;
+    DWORD miscstatusdocprint;
+};
+
+typedef char shpin_comclassredirect_data_size_check[
+    sizeof(struct shpin_comclassredirect_data) == 120 ? 1 : -1];
+typedef char shpin_comclassredirect_data_name_offset_check[
+    FIELD_OFFSET(struct shpin_comclassredirect_data, name_offset) == 80 ? 1 : -1];
+
+static __inline BOOL SHPinActCtxRangeValid(const void *base, SIZE_T size,
+                                           const void *ptr, SIZE_T length)
+{
+    ULONG_PTR start = (ULONG_PTR)base, address = (ULONG_PTR)ptr;
+
+    if (!base || !ptr || address < start || size > (SIZE_T)-1 - start)
+        return FALSE;
+    if (address - start > size || length > size - (address - start))
+        return FALSE;
+    return TRUE;
+}
+
+static __inline BOOL SHPinActCtxStringValid(const void *base, SIZE_T size,
+                                            LPCWSTR string, ULONG length)
+{
+    ULONG i, chars;
+
+    if (!length || length % sizeof(WCHAR) || (ULONG_PTR)string % sizeof(WCHAR) ||
+        (SIZE_T)length > (SIZE_T)-1 - sizeof(WCHAR) || !string ||
+        !SHPinActCtxRangeValid(base, size, string, (SIZE_T)length + sizeof(WCHAR)))
+        return FALSE;
+
+    chars = length / sizeof(WCHAR);
+    if (string[chars])
+        return FALSE;
+
+    for (i = 0; i < chars; ++i)
+    {
+        if (!string[i])
+            return FALSE;
+        if (string[i] >= 0xd800 && string[i] <= 0xdbff)
+        {
+            if (++i >= chars || string[i] < 0xdc00 || string[i] > 0xdfff)
+                return FALSE;
+        }
+        else if (string[i] >= 0xdc00 && string[i] <= 0xdfff)
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static __inline DWORD SHPinParseActCtxComServer(const ACTCTX_SECTION_KEYED_DATA *data,
+                                                 LPCGUID clsid, LPCWSTR *module_name)
+{
+    const struct shpin_comclassredirect_data *redirect;
+    SIZE_T total;
+
+    if (!module_name)
+        return ERROR_INVALID_PARAMETER;
+    *module_name = NULL;
+
+    if (!data || !clsid ||
+        data->cbSize < FIELD_OFFSET(ACTCTX_SECTION_KEYED_DATA, ulAssemblyRosterIndex) + sizeof(ULONG))
+        return ERROR_INVALID_PARAMETER;
+
+    if (data->ulDataFormatVersion != 1)
+        return ERROR_REVISION_MISMATCH;
+    if (!data->ulAssemblyRosterIndex || data->ulLength < sizeof(*redirect) ||
+        (ULONG_PTR)data->lpData % sizeof(ULONG) ||
+        !SHPinActCtxRangeValid(data->lpSectionBase, data->ulSectionTotalLength,
+                               data->lpData, data->ulLength))
+        return ERROR_INVALID_DATA;
+
+    redirect = data->lpData;
+    if (redirect->size < sizeof(*redirect) || redirect->size > data->ulLength ||
+        redirect->name_offset > data->ulSectionTotalLength ||
+        redirect->name_len > data->ulSectionTotalLength - redirect->name_offset ||
+        sizeof(WCHAR) > data->ulSectionTotalLength - redirect->name_offset - redirect->name_len ||
+        redirect->name_offset % sizeof(WCHAR) ||
+        (memcmp(&redirect->clsid, clsid, sizeof(*clsid)) &&
+         memcmp(&redirect->alias, clsid, sizeof(*clsid))))
+        return ERROR_INVALID_DATA;
+
+    if (redirect->clrdata_len)
+        return ERROR_NOT_SUPPORTED;
+
+    total = data->ulSectionTotalLength;
+    *module_name = (LPCWSTR)((const BYTE *)data->lpSectionBase + redirect->name_offset);
+    if (!SHPinActCtxStringValid(data->lpSectionBase, total, *module_name, redirect->name_len))
+    {
+        *module_name = NULL;
+        return ERROR_INVALID_DATA;
+    }
+    return ERROR_SUCCESS;
+}
+
+#endif /* __SHLWAPI_SXSACTCTX_H */
