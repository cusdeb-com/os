+/* Wine 11.19's private COM-redirection layout; Win32 exposes no provider-name accessor. */
+static BOOL SHResolveActCtxComServer(REFIID refiid, WCHAR **path, BOOL *found)
+{
+    ACTCTX_SECTION_KEYED_DATA data;
+    ACTCTX_SECTION_KEYED_DATA file_data;
+    PACTIVATION_CONTEXT_DATA_DLL_REDIRECTION dll_redirect;
+    LPCWSTR module_name;
+    WCHAR resolved_path[MAX_PATH];
+    ULONG_PTR cookie;
+    DWORD error, path_len;
+    BOOL result = FALSE, actctx_active = FALSE;
+
+    *path = NULL;
+    *found = FALSE;
+    memset(&data, 0, sizeof(data));
+    memset(&file_data, 0, sizeof(file_data));
+    data.cbSize = sizeof(data);
+    file_data.cbSize = sizeof(file_data);
+
+    if (!FindActCtxSectionGuid(FIND_ACTCTX_SECTION_KEY_RETURN_HACTCTX, NULL,
+                               ACTIVATION_CONTEXT_SECTION_COM_SERVER_REDIRECTION,
+                               refiid, &data))
+    {
+        error = GetLastError();
+        if (error == ERROR_SXS_KEY_NOT_FOUND)
+        {
+            *found = FALSE;
+            return TRUE;
+        }
+        SetLastError(error);
+        return FALSE;
+    }
+
+    *found = TRUE;
+    if (!data.hActCtx)
+    {
+        error = ERROR_INVALID_DATA;
+        goto done;
+    }
+    error = SHPinParseActCtxComServer(&data, refiid, &module_name);
+    if (error != ERROR_SUCCESS)
+        goto done;
+
+    if (!ActivateActCtx(data.hActCtx, &cookie))
+    {
+        error = GetLastError();
+        goto done;
+    }
+    actctx_active = TRUE;
+
+    if (!FindActCtxSectionString(FIND_ACTCTX_SECTION_KEY_RETURN_HACTCTX, NULL,
+                                 ACTIVATION_CONTEXT_SECTION_DLL_REDIRECTION,
+                                 module_name, &file_data))
+    {
+        error = GetLastError();
+        goto done;
+    }
+    if (!file_data.hActCtx || file_data.ulDataFormatVersion != 1 ||
+        file_data.ulLength < sizeof(*dll_redirect) ||
+        (ULONG_PTR)file_data.lpData % sizeof(ULONG) ||
+        !SHPinActCtxRangeValid(file_data.lpSectionBase, file_data.ulSectionTotalLength,
+                               file_data.lpData, file_data.ulLength) ||
+        file_data.ulAssemblyRosterIndex != data.ulAssemblyRosterIndex)
+    {
+        error = ERROR_INVALID_DATA;
+        goto done;
+    }
+    dll_redirect = file_data.lpData;
+    if (dll_redirect->Size < sizeof(*dll_redirect) || dll_redirect->Size > file_data.ulLength)
+    {
+        error = ERROR_INVALID_DATA;
+        goto done;
+    }
+
+    /* SearchPathW resolves the name through the activated DLL-redirection section. */
+    path_len = SearchPathW(NULL, module_name, L".dll", ARRAY_SIZE(resolved_path),
+                           resolved_path, NULL);
+    if (!path_len || path_len >= ARRAY_SIZE(resolved_path))
+    {
+        error = path_len ? ERROR_INSUFFICIENT_BUFFER : GetLastError();
+        goto done;
+    }
+
+    *path = HeapAlloc(GetProcessHeap(), 0, ((SIZE_T)path_len + 1) * sizeof(WCHAR));
+    if (!*path)
+    {
+        error = ERROR_NOT_ENOUGH_MEMORY;
+        goto done;
+    }
+    CopyMemory(*path, resolved_path, ((SIZE_T)path_len + 1) * sizeof(WCHAR));
+    result = TRUE;
+
+done:
+    if (actctx_active && !DeactivateActCtx(0, cookie))
+    {
+        error = GetLastError();
+        result = FALSE;
+    }
+    if (file_data.hActCtx) ReleaseActCtx(file_data.hActCtx);
+    if (data.hActCtx) ReleaseActCtx(data.hActCtx);
+    if (!result)
+    {
+        if (*path) HeapFree(GetProcessHeap(), 0, *path);
+        *path = NULL;
+        SetLastError(error);
+    }
+    return result;
+}
