Author: Artem Lavrukhin <lavryha4590@gmail.com>
Description: Build shell icons from external generated assets.
 Keep project-owned SVG icons and generated ICO files outside the ReactOS
 source tree. Pass a single generated path catalog to shell32 so replacing
 an icon never mutates or restores an upstream resource file.
Last-Modified: Mon, 21 Sep 2026 15:00:00 +0300

--- a/src/dll/win32/shell32/CMakeLists.txt
+++ b/src/dll/win32/shell32/CMakeLists.txt
@@ -4,6 +4,20 @@
 add_subdirectory(shellmenu)
 add_subdirectory(shellrecyclebin)
 
+if(CDEX_ICON_BUILD_DIR)
+    set(CDEX_ICON_HEADER "${CDEX_ICON_BUILD_DIR}/cdex_icon_paths.h")
+    if(NOT EXISTS "${CDEX_ICON_HEADER}")
+        message(FATAL_ERROR
+            "CDEX_ICON_BUILD_DIR is set, but the generated icon header is missing: ${CDEX_ICON_HEADER}")
+    endif()
+    file(GLOB shell32_cdex_icon_deps CONFIGURE_DEPENDS
+        "${CDEX_ICON_BUILD_DIR}/*.ico")
+    if(NOT shell32_cdex_icon_deps)
+        message(FATAL_ERROR
+            "CDEX_ICON_BUILD_DIR is set, but no generated ICO files were found: ${CDEX_ICON_BUILD_DIR}")
+    endif()
+endif()
+
 spec2def(shell32.dll shell32.spec ADD_IMPORTLIB)
 
 remove_definitions(-D_WIN32_WINNT=0x502)
@@ -106,6 +120,9 @@
 # a later set_source_files_properties call replaces that list instead of
 # appending to it.
 file(GLOB_RECURSE shell32_rc_deps CONFIGURE_DEPENDS res/*.*)
+if(CDEX_ICON_BUILD_DIR)
+    list(APPEND shell32_rc_deps ${CDEX_ICON_HEADER} ${shell32_cdex_icon_deps})
+endif()
 list(APPEND shell32_rc_deps ${CMAKE_CURRENT_BINARY_DIR}/shell32_shldisp.tlb)
 add_rc_deps(shell32.rc ${shell32_rc_deps})
 
@@ -115,6 +132,11 @@
     shell32.rc
     ${CMAKE_CURRENT_BINARY_DIR}/shell32.def)
 
+if(CDEX_ICON_BUILD_DIR)
+    target_include_directories(shell32 PRIVATE "${CDEX_ICON_BUILD_DIR}")
+    target_compile_definitions(shell32 PRIVATE CDEX_EXTERNAL_SHELL_ICONS=1)
+endif()
+
 if(MSVC)
     # error C4311: 'type cast': pointer truncation from 'HANDLE' to 'INT'
     remove_target_compile_option(shell32 "/we4311")
