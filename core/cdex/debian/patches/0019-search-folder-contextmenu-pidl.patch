         if (!pszVerb && SUCCEEDED(GetCommandStringA(m_pInner, LOWORD(lpcmi->lpVerb), GCS_VERBA, szVerb, _countof(szVerb))))
             pszVerb = szVerb;
 
+        // Keep Search Results from navigating its own virtual folder. Resolve
+        // filesystem folders to native Explorer frames and files through their
+        // normal associations, including mixed and multi-selections.
+        if (pszVerb && !lstrcmpiA(pszVerb, "open"))
+        {
+            PCUITEMID_CHILD *apidl;
+            UINT cidl;
+            HRESULT hResult = m_shellFolderView->GetSelectedObjects(&apidl, &cidl);
+            if (SUCCEEDED(hResult))
+            {
+                BOOL allFilesystemItems = cidl > 0;
+                for (UINT i = 0; allFilesystemItems && i < cidl; ++i)
+                {
+                    PIDLIST_ABSOLUTE pidlAbs = _ILCreateAbsolute(apidl[i]);
+                    WCHAR path[MAX_PATH];
+                    allFilesystemItems = pidlAbs && SHGetPathFromIDListW(pidlAbs, path) &&
+                                         GetFileAttributesW(path) != INVALID_FILE_ATTRIBUTES;
+                    if (pidlAbs)
+                        ILFree(pidlAbs);
+                }
+
+                if (allFilesystemItems)
+                {
+                    BOOL bAnyFailed = FALSE;
+                    for (UINT i = 0; i < cidl; ++i)
+                    {
+                        PIDLIST_ABSOLUTE pidlAbs = _ILCreateAbsolute(apidl[i]);
+                        WCHAR path[MAX_PATH];
+                        if (!pidlAbs || !SHGetPathFromIDListW(pidlAbs, path))
+                        {
+                            bAnyFailed = TRUE;
+                            if (pidlAbs)
+                                ILFree(pidlAbs);
+                            continue;
+                        }
+
+                        if (GetFileAttributesW(path) & FILE_ATTRIBUTE_DIRECTORY)
+                        {
+                            hResult = SHOpenNewFrame(pidlAbs, NULL, 0,
+                                                     SH_EXPLORER_CMDLINE_FLAG_NEWWND |
+                                                     SH_EXPLORER_CMDLINE_FLAG_NOREUSE);
+                            pidlAbs = NULL; // SHOpenNewFrame takes ownership.
+                            if (FAILED(hResult))
+                                bAnyFailed = TRUE;
+                        }
+                        else
+                        {
+                            HINSTANCE hInst = ShellExecuteW(lpcmi->hwnd, L"open", path,
+                                                             NULL, NULL, SW_SHOWNORMAL);
+                            if ((INT_PTR)hInst <= HINSTANCE_ERROR)
+                                bAnyFailed = TRUE;
+                        }
+
+                        if (pidlAbs)
+                            ILFree(pidlAbs);
+                    }
+                    LocalFree(apidl);
+                    return bAnyFailed ? E_FAIL : S_OK;
+                }
+                LocalFree(apidl);
+            }
+        }
+
         if (pszVerb && !lstrcmpiA(pszVerb, "rename"))
         {
             // Note: We can't invoke m_pInner (CDefaultContextMenu::DoRename) because the pidl is incorrect and SelectItem will fail.
