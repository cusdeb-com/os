Author: CusDeb OS Team
Description: Fix opening objects from the Search Results folder.
 _ILCreateAbsolute used a NULL local PIDL instead of pidlChild and
 SHSimpleIDListFromPath; construct the absolute PIDL from the child path with
 ILCreateFromPathW.
 Build context menus through the desktop folder from absolute filesystem PIDLs,
 so results from different parent directories and non-contiguous selections use
 the correct shell objects.
 Intercept the "open" verb for filesystem results: open folders in new Explorer
 frames and files through their normal associations, including mixed selections.
Last-Modified: Tue, 08 Sep 2026 19:30:45 +0300

--- a/src/dll/win32/browseui/shellfind/CFindFolder.cpp
+++ b/src/dll/win32/browseui/shellfind/CFindFolder.cpp
@@ -7,6 +7,7 @@
 
 #include "CFindFolder.h"
 #include <exdispid.h>
+#include <browseui_undoc.h>
 
 WINE_DEFAULT_DEBUG_CHANNEL(shellfind);
 
@@ -204,9 +205,9 @@
 static PIDLIST_ABSOLUTE _ILCreateAbsolute(LPCITEMIDLIST pidlChild)
 {
     PIDLIST_ABSOLUTE pidl = NULL;
-    if (PIDLIST_ABSOLUTE pidlFolder = SHSimpleIDListFromPath(_ILGetPath(pidl))) // FIXME: SHELL32_CreateSimpleIDListFromPath(, DIRECTORY)
+    if (PIDLIST_ABSOLUTE pidlFolder = ILCreateFromPathW(_ILGetPath(pidlChild)))
     {
-        pidl = ILCombine(pidlFolder, _ILGetFSPidl(pidl));
+        pidl = ILCombine(pidlFolder, _ILGetFSPidl(pidlChild));
         ILFree(pidlFolder);
     }
     return pidl;
