#!/bin/sh
set -e

# Initialize greetd's configuration on a fresh installation. Keep the template
# outside /etc to avoid a file ownership conflict with the greetd package, and
# preserve the installed system's login settings on subsequent upgrades.
if [ "$1" = configure ] && [ -z "${2:-}" ]; then
    install -D -m 644 /usr/share/cusdeb/greetd/config.toml /etc/greetd/config.toml
fi

# Enable services required by the desktop environment.
if [ -x /usr/bin/systemctl ]; then
    # Select greetd for the next boot without restarting a running session.
    systemctl enable --force greetd.service || true
    systemctl enable systemd-networkd.service || true
    systemctl enable systemd-resolved.service || true
fi

# Refresh the fontconfig cache for the bundled fonts.
if [ -x /usr/bin/fc-cache ]; then
    fc-cache -f || true
fi

#DEBHELPER#

exit 0
